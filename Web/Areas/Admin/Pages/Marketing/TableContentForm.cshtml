@page
@model MojeVlastniStranka.User.Areas.Admin.Pages.Marketing.TableContentFormModelPage
@{
	ViewData["Title"] = "Tabulka Kontaktních formulářů";
}
 
<div class="col-sm-12">
<div class="bg-secondary rounded h-100 p-4">
	<h6 class="mb-4">Data z formuláře</h6>
	<table class="table table-striped">
		<thead>
		<tr>
			<th>Jméno</th>
			<th>Příjmení</th>
			<th>Email</th>
			<th>Telefonní číslo</th>
			<th>Zpráva</th>
			<th>Datum</th>
		</tr>
		</thead>
		<tbody>
		@foreach (var form in Model.ViewModel)
		{
			<tr>
				<td>@form.FirstName</td>
				<td>@form.LastName</td>
				<td><a href="mailto:@form.Email">@form.Email</a></td>
				<td><a href="tel:@form.PhoneNumber">@form.PhoneNumber</a></td>
				<td>@form.Message</td>
				<td>@form.SendTime</td>
			</tr>
		}

		</tbody>
	</table>
</div>
</div>
