@page
@using MojeVlastniStranka.ApplicationCore.Constants
@model MojeVlastniStranka.Admin.Areas.Identity.Pages.Account.Manage.Marketing.TableContentFormModelPage
@{
    ViewData[ViewDataKeys.Title] = "Tabulka Kontaktních formulářů";
}

<div class="col-sm-12">
    <div class="bg-secondary rounded h-100 p-4">
        <h6 class="mb-4">Data z formuláře</h6>
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Telefonní číslo</th>
                    <th>Zpráva</th>
                    <th>Datům</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var form in Model.ViewModel)
                {
                    <tr>
                        <td><a href="mailto:@form.Email">@form.Email</a></td>
                        <td><a href="tel:@form.PhoneNumber">@form.PhoneNumber</a></td>
                        <td>@form.Message</td>
                        <td>@form.Date</td>
                        <td>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@form.Id" class="d-inline" onsubmit="return confirm('Opravdu chcete smazat tento formulář?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Smazat</button>
                            </form>
                        </td>
                    </tr>
                }

            </tbody>
        </table>
    </div>
</div>
