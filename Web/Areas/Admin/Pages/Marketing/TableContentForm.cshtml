@page
@model MojeVlastniStranka.Admin.Areas.Identity.Pages.Account.Manage.Marketing.TableContentFormModelPage
@{
	ViewData["Title"] = "Tabulka Kontaktních formulářů";
}

<div class="col-sm-12">
	<div class="bg-secondary rounded h-100 p-4">
		<h6 class="mb-4">Data z formuláře</h6>
		<table class="table table-striped">
			<thead>
				<tr>
					<th>Email</th>
					<th>Telefonní číslo</th>
					<th>Zpráva</th>
					<th>Datům</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var form in Model.ViewModel)
				{
					<tr>
						<td><a href="mailto:@form.Email">@form.Email</a></td>
						<td><a href="tel:@form.PhoneNumber">@form.PhoneNumber</a></td>
						<td>@form.Message</td>
						<td>@form.Date</td>
					</tr>
				}

			</tbody>
		</table>
	</div>
</div>
