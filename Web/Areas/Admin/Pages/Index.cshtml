@page
@model MojeVlastniStranka.User.Areas.Admin.Pages.Account.Manage.IndexModel
@{
	ViewData["Title"] = "Hlavní stránka";
}
<div class="row g-4">
<div class="col-sm-6 col-xl-3">
	<div class="bg-secondary rounded d-flex align-items-center justify-content-between p-4">
		<i class="fa fa-chart-line fa-3x text-primary"></i>
		<div class="ms-3">
			<p class="mb-2">Počet blog příspěvků</p>
			<h6 class="mb-0">@Model.NumberOfBlogPosts</h6>
		</div>
	</div>
</div>
<div class="col-sm-6 col-xl-3">
	<div class="bg-secondary rounded d-flex align-items-center justify-content-between p-4">
		<i class="fa fa-chart-line fa-3x text-primary"></i>
		<div class="ms-3">
			<p class="mb-2">Počet formulářů</p>
			<h6 class="mb-0">@Model.NumberOfContactForms</h6>
		</div>
	</div>
</div>
</div>