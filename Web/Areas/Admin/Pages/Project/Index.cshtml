@page
@model MojeVlastniStranka.Web.Areas.Admin.Pages.Project.IndexModel
@using MojeVlastniStranka.Common.Enums
@{
	ViewData["Title"] = "Seznam projektů";
}

<div class="bg-secondary rounded h-100 p-4">
	<form method="get">
		<div class="row">
			<div class="col-md-3 mb-3">
				<input type="text" class="form-control" placeholder="Hledat podle názvu" name="search" />
			</div>
			<div class="col-md-3 mb-3">
				<select class="form-select" name="projectStatusEnum">
					<option value="">Všechny statusy</option>
					@foreach (ProjectStatusEnum status in Enum.GetValues(typeof(ProjectStatusEnum)))
					{
						<option value="@status">@status</option>
					}
				</select>
			</div>
		</div>
		<div class="row">
			<button class="btn btn-primary" type="submit">Filtrovat</button>
		</div>
	</form>
	<div class="row mt-4">
		@foreach (var project in Model.Projects)
		{
			<div class="col-md-4">
				<div class="project-summary">
					<div class="card mb-4 shadow-sm">
						<img class="bd-placeholder-img card-img-top" src="@project.ImagePath" alt="Image description">
						<div class="card-body">
							<h2 class="card-text"><a asp-page="./EditProject" asp-route-id="@project.Id">@project.Name</a></h2>
							<p>@project.Description</p>
							<p>@project.ProjectStatus</p>
							<div class="d-flex justify-content-between align-items-center">
								<div class="btn-group">
									<a class="btn btn-sm btn-outline-secondary" asp-page="./EditProject" asp-route-id="@project.Id">Edit</a>
									<a class="btn btn-sm btn-outline-secondary" target="_blank" href="/projekty/@project.Slug/">Pohled</a>
								</div>
								<small class="text-muted">@project.PublicDate</small>
							</div>
						</div>
					</div>
				</div>
			</div>
		}
	</div>
</div>
