@page
@using MojeVlastniStranka.ApplicationCore.Constants
@model MojeVlastniStranka.Web.Areas.Admin.Pages.GameIdeas.IndexModel
@{
    ViewData[ViewDataKeys.Title] = "Seznam námětů na hru";
}

<div class="bg-secondary rounded h-100 p-4">
    <div class="row mb-4">
        <div class="col-12">
            <a asp-page="./Create" class="btn btn-primary">Přidat nový námět</a>
        </div>
    </div>
    
    <div class="row mt-4">
        @foreach (var idea in Model.GameIdeas)
        {
            <div class="col-md-4">
                <div class="blog-post-summary">
                    <div class="card mb-4 shadow-sm bg-dark text-white">
                        @if (!string.IsNullOrEmpty(idea.ImageUrl))
                        {
                            <img class="bd-placeholder-img card-img-top" src="@idea.ImageUrl" alt="@idea.TitleCs">
                        }
                        <div class="card-body">
                            <h2 class="card-text">@idea.TitleCs</h2>
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <div class="btn-group">
                                    <a class="btn btn-sm btn-outline-light" asp-page="./Edit" asp-route-id="@idea.Id">Upravit</a>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@idea.Id" class="d-inline" onsubmit="return confirm('Opravdu chcete smazat tento námět?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger ms-2">Smazat</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
