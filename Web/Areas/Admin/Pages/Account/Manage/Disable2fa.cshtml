@page
@using MojeVlastniStranka.ApplicationCore.Constants
@model Disable2faModel
@{
    ViewData[ViewDataKeys.Title] = "Vypnutí dvoufázového ověření (2FA)";
}

<div class="bg-secondary rounded h-100 p-4">
    <partial name="_StatusMessage" for="StatusMessage" />
    <h2>@ViewData[ViewDataKeys.Title]</h2>

    <div class="alert alert-warning" role="alert">
        <p>
            <span class="glyphicon glyphicon-warning-sign"></span>
            <strong>This action only disables 2FA.</strong>
        </p>
        <p>
            Disabling 2FA does not change the keys used in authenticator apps. If you wish to change the key
            used in an authenticator app you should <a asp-page="./ResetAuthenticator">reset your authenticator keys.</a>
        </p>
    </div>

    <div>
        <form method="post" class="form-group">
            <button class="btn btn-danger mt-2" type="submit">Disable 2FA</button>
        </form>
    </div>
</div>