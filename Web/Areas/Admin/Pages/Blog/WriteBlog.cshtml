@page
@model MojeVlastniStranka.User.Areas.Admin.Pages.Blog.WriteBlogModel
@{
	ViewData["Title"] = "Napsání blogu";
}
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>

<link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.js"></script>
<script src="/js/summernote/Plugins/summernote-ext-addclass.js"></script>
<script src="/js/summernote/Plugins/summernote-ownplugin.js"></script>
<script src="/lib/typo-js/typo.js"></script>
<div class="col-md-12">
	@if (!string.IsNullOrEmpty(Model.SuccessMessage))
	{
		<div class="alert alert-success">
			@Model.SuccessMessage
		</div>
	}

	else if (!ViewData.ModelState.IsValid)
	{
		<div class="alert alert-danger">
			@Html.ValidationSummary(false, "", new { @class = "text-danger" })
		</div>
	}
	<link rel="stylesheet" href="~/css/fast-style-blog.css" asp-append-version="true" />
	<div id="summernote"></div>
	<button id="editSettingsBtn" class="btn btn-primary">Publikovat</button>
</div>


 <style>
	#settingsTable {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-color: rgba(0, 0, 0, 0.8);
		z-index: 999; 
		display: none; 
	}

	#settingsForm {
		padding: 20px;
	}
</style> 
<div class="container d-flex justify-content-center">
	<div id="settingsTable">
		<div>
			<div class="row">
				<div class="col-md-4  mx-auto" style="margin-top:116px">
					<form id="settingsForm" method="post" enctype="multipart/form-data">
						<div class="form-group">
							<label for="Name" class="text-white">Jméno blogu:</label>
							<input name="Name" type="text" class="form-control" required />
						</div>
						<div class="form-group">
							<label for="Slug" class="text-white">Url blogu:</label>
							<input name="Slug" type="text" class="form-control" required/>
						</div>
						<div class="form-group">
							<label for="Title" class="text-white">Titulek:</label>
							<input type="text" class="form-control" name="Title" required/>
						</div>
						<div class="form-group">
							<label for="Description" class="text-white">Popis:</label>
							<input type="text" class="form-control" name="Description" required/>
						</div>
						<div class="form-group">
							<label for="Author" class="text-white">Autor:</label>
							<input type="text" class="form-control" name="Author" required/>
						</div>
						<div class="form-group">
							<label for="Keywords" class="text-white">Klíčová slova:</label>
							<input type="text" class="form-control" name="Keywords" id="keywords" required/>
						</div>
						<div class="form-group">
							<label for="file" class="text-white">Obrázek:</label>
							<input type="file" class="form-control-file" name="FileUpload" id="file"/>
							<div id="image-preview"></div>
						</div>
						<div class="form-group">
							<label for="BlogCategoryId" class="text-white">Kategorie blogů:</label>
							<select class="form-control" name="BlogCategoryId">
								@foreach (var category in Model.BlogCategory)
								{
									<option value=@category.Id>@category.Name</option>
								}
								<option value="">Bez kategorie</option>
							</select>
						</div>
						<input type="hidden" name="Content" id="hiddenContent" />
						<button type="submit" class="btn btn-primary">Publikovat</button>
						<button id="backBtn" class="btn btn-secondary">Zpátky</button>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>
<script>

	$('#editSettingsBtn').click(function () {
		$('#settingsTable').toggle();
	});

	// Tlačítko pro vrácení zpět
	$('#backBtn').click(function () {
		$('#settingsTable').hide();
	});

	// Definování základního textu pro snaží orientaci v editoru
	var defaultContent = '<main class="main"><header><h1>Proč používat unity engine?</h1></header><p>V dnešní době unity engine se tak moc rozvinul i skrz ai, že se to dneš již vyplatí.</p></main>';

	// Inicializování summernote
	$('#summernote').summernote({
		lang: 'cs-CZ',
		dialogsInBody: true,
		spellCheck: true,
		addclass: {
			debug: false,
			classTags: [{ title: "Button", "value": "btn btn-success" }, "body", "red", "h2__div__article", "header__h1", "fadeInLeft", "header__other", "header__p", "main" ]
		},
		focus: true,
		height: 300,
		toolbar: [
			['structure', ['structurePlugin']],
			['img', ['picture']],
			['style', ['style', 'addclass', 'clear']],
			['fontstyle', ['bold', 'italic', 'ul', 'ol', 'link', 'paragraph']],
			['fontstyleextra', ['strikethrough', 'underline', 'hr', 'color', 'superscript', 'subscript']],
			['extra', ['video', 'table', 'height']],
			['misc', ['undo', 'redo', 'codeview', 'help']],
			['fontname', ['fontname']],
			['fullscreen', ['fullscreen']]
		],
		callbacks: {
			onInit: function () {
				$('#summernote').summernote('code', defaultContent);
			}
		}
	});

	// Při odesílání formuláře zaregistrovat, zda tam je nějaký obsah
	$('form').on('submit', function () {
		var htmlContent = $('.note-editable').html().trim();

		$('#hiddenContent').val(htmlContent);
		if (htmlContent === '' || htmlContent === '<p><br></p>') {
			return null;
		}
	});

	// Ukazání obrázků po jeho odesláním
	function showImagePreview(input) {
		if (input.files && input.files[0]) {
			var reader = new FileReader();

			reader.onload = function (e) {
				var img = document.createElement('img');
				img.src = e.target.result;

				var previewDiv = document.getElementById('image-preview');
				previewDiv.innerHTML = '';
				previewDiv.appendChild(img);
			}

			reader.readAsDataURL(input.files[0]);
		}
	}

	document.getElementById('file').addEventListener('change', function () {
		showImagePreview(this);
	});

	// Speciální efekt pro moji stránku
	$(document).ready(function () {
		$('.note-editable').addClass('body');
		$(window).scroll(function () {
			$('.fadeIn, .fadeInUp, .fadeInDown, .fadeInRight, .fadeInLeft').each(function () {
				let position = $(this).offset().top;
				let topPosition = $(window).scrollTop() + $(window).height();
				if (position < topPosition) {
					$(this).addClass('visible');
				}
			});
		});
	});
</script>