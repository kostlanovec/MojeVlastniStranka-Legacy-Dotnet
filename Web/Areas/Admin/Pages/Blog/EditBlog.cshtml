@page
@model MojeVlastniStranka.User.Areas.Admin.Pages.Blog.EditBlogPostModel
@{
	ViewData["Title"] = "Editování blogu";
}
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.js"></script>
<script src="/js/summernote/Plugins/summernote-ext-addclass.js"></script>
<script src="/js/summernote/Plugins/summernote-ownplugin.js"></script>
<script src="/lib/typo-js/typo.js"></script>
<link rel="stylesheet" href="~/css/fast-style-blog.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.7.0/styles/github-dark-dimmed.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.7.0/highlight.min.js"></script>
<script>
	document.addEventListener("DOMContentLoaded", function () {
		hljs.highlightAll();
	});
</script>

<div class="col-md-12">
	@await Html.PartialAsync("_ResponseViewModel", Model.responseViewModel)
	<link rel="stylesheet" href="~/css/fast-style-blog.css" asp-append-version="true" />
	<h3>Český obsah</h3>
	<div id="summernote"></div>
	<h3 class="mt-4">Anglický obsah</h3>
	<div id="summernote-en"></div>
	<button id="editSettingsBtn" class="btn btn-primary">Publikovat</button>
</div>
<div class="container d-flex justify-content-center">
	<div id="settingsTable">
		<div class="container">
			<div class="row">
				<div class="col-md-4 mx-auto">
					<form id="settingsForm" method="post" enctype="multipart/form-data" class="mt-2">
						<h1>Editování blog příspěvku.</h1>
						<div class="form-group mt-2">
							<label for="Name" class="text-white">Jméno blogu:</label>
							<input name="Name" type="text" class="form-control bg-white" value="@Model.EditBlogPostDto.Name" required />
							<label for="NameEn" class="text-white mt-2">Jméno blogu (EN):</label>
							<input name="NameEn" type="text" class="form-control bg-white" value="@Model.EditBlogPostDto.NameEn" />
						</div>
						<div class="form-group mt-2">
							<label for="Slug" class="text-white">Url blogu:</label>
							<input name="Slug" type="text" class="form-control bg-white" value="@Model.EditBlogPostDto.Slug" required />
						</div>
						<div class="form-group mt-2">
							<label for="Title" class="text-white">Titulek:</label>
							<input type="text" class="form-control bg-white" name="Title" value="@Model.EditBlogPostDto.Title" required />
							<label for="TitleEn" class="text-white mt-2">Titulek (EN):</label>
							<input type="text" class="form-control bg-white" name="TitleEn" value="@Model.EditBlogPostDto.TitleEn" />
						</div>
						<div class="form-group mt-2">
							<label for="floatingTextarea" class="text-white">Popis:</label>
							<textarea class="form-control bg-white" placeholder="Zanech vystižný popis" id="floatingTextarea" name="Description" required>@Model.EditBlogPostDto.Description</textarea>
							<label for="DescriptionEn" class="text-white mt-2">Popis (EN):</label>
							<textarea class="form-control bg-white" placeholder="Popis (EN)" name="DescriptionEn">@Model.EditBlogPostDto.DescriptionEn</textarea>
						</div>
						<div class="form-group mt-2">
							<label for="Author" class="text-white">Autor:</label>
							<input type="text" class="form-control bg-white" name="Author" value="@Model.EditBlogPostDto.Author" required />
						</div>
						<div class="form-group mt-2">
							<label for="Keywords" class="text-white">Klíčová slova:</label>
							<input type="text" class="form-control bg-white" name="Keywords" value="@Model.EditBlogPostDto.Keywords" required />
							<label for="KeywordsEn" class="text-white mt-2">Klíčová slova (EN):</label>
							<input type="text" class="form-control bg-white" name="KeywordsEn" value="@Model.EditBlogPostDto.KeywordsEn" />
						</div>
						<div class="form-group mt-2">
							<label for="file" class="text-white">Obrázek:</label>
							<input type="file" class="form-control bg-dark" name="FileUpload" id="file" />
							<div id="image-preview">
								<img src="@Model.EditBlogPostDto.FileUpload" />
							</div>
						</div>
						<div class="form-group mt-2">
							<label for="BlogCategoryId" class="text-white">Kategorie blogů:</label>
							<select class="form-select bg-white" name="BlogCategoryId">
								@if (Model.EditBlogPostDto.BlogCategoryId == null)
								{
									<option value="" selected>Bez kategorie</option>
								}
								else
								{
									<option value="">Bez kategorie</option>
								}

								@foreach (var category in Model.BlogCategory)
								{
									if (category.Id == Model.EditBlogPostDto.BlogCategoryId)
									{
										<option value="@category.Id" selected>@category.Name</option>
									}
									else
									{
										<option value="@category.Id">@category.Name</option>
									}
								}
							</select>

						</div>
						<input type="hidden" name="Content" id="hiddenContent" />
						<input type="hidden" name="ContentEn" id="hiddenContentEn" />
						<input type="hidden" asp-for="Id" />
						<button type="submit" asp-page-handler="DeleteBlogById" class="btn btn-danger mt-2">Odstranit</button>
						<button id="backBtn" type="button" class="btn btn-secondary mt-2">Zpátky</button>
						<button type="submit" asp-page-handler="UpdateBlogPost" class="btn btn-primary mt-2">Aktualizovat</button>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>

<script>
	$('#editSettingsBtn').click(function () {
		$('#settingsTable').toggle();
	});

	$('#backBtn').click(function () {
		$('#settingsTable').hide();
	});

	// Inicializování summernote
	
	$('#summernote-en').summernote({
		lang: 'en-US',
		spellCheck: true,
		addclass: {
			debug: false,
			classTags: [{ title: "Button", "value": "btn btn-success" }, "body", "red", "h2__div__article", "header__h1", "fadeInLeft", "header__other", "header__p", "main"]
		},
		focus: false,
		height: 300,
		toolbar: [
			['structure', ['structurePlugin']],
			['img', ['picture']],
			['style', ['style', 'addclass', 'clear']],
			['fontstyle', ['bold', 'italic', 'ul', 'ol', 'link', 'paragraph']],
			['fontstyleextra', ['strikethrough', 'underline', 'hr', 'color', 'superscript', 'subscript']],
			['extra', ['video', 'table', 'height']],
			['misc', ['undo', 'redo', 'codeview', 'help']],
			['fontname', ['fontname']],
			['fullscreen', ['fullscreen']]
		]
	});

	$('#summernote').summernote({
		lang: 'cs-CZ',
		spellCheck: true,
		addclass: {
			debug: false,
			classTags: [{ title: "Button", "value": "btn btn-success" }, "body", "red", "h2__div__article", "header__h1", "fadeInLeft", "header__other", "header__p", "main"]
		},
		focus: true,
		height: 300,
		toolbar: [
			['structure', ['structurePlugin']],
			['img', ['picture']],
			['style', ['style', 'addclass', 'clear']],
			['fontstyle', ['bold', 'italic', 'ul', 'ol', 'link', 'paragraph']],
			['fontstyleextra', ['strikethrough', 'underline', 'hr', 'color', 'superscript', 'subscript']],
			['extra', ['video', 'table', 'height']],
			['misc', ['undo', 'redo', 'codeview', 'help']],
			['fontname', ['fontname']],
			['fullscreen', ['fullscreen']]
		],
		callbacks: {
			onInit: function () {
					var htmlContent = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EditBlogPostDto.Content));
					var htmlContentEn = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EditBlogPostDto.ContentEn));
				$('#summernote').summernote('code', htmlContent);
				$('#summernote-en').summernote('code', htmlContentEn);
			}
		}
	});

	// Odesílání formuláře
	$('form').on('submit', function () {
		var htmlContent = $('.note-editable').html().trim();
		$('#hiddenContent').val(htmlContent);
		var htmlContentEn = $('#summernote-en').summernote('code');
		$('#hiddenContentEn').val(htmlContentEn);
		if (htmlContent === '' || htmlContent === '<p><br></p>') {
			return null;
		}
	});

	// Vykreslení obrázku po nahrátí
	function showImagePreview(input) {
		if (input.files && input.files[0]) {
			var reader = new FileReader();

			reader.onload = function (e) {
				var img = document.createElement('img');
				img.src = e.target.result;

				var previewDiv = document.getElementById('image-preview');
				previewDiv.innerHTML = '';
				previewDiv.appendChild(img);
			};

			reader.readAsDataURL(input.files[0]);
		}
	}

	document.getElementById('file').addEventListener('change', function () {
		showImagePreview(this);
	});

	// Speciální efekt pro moji stránku
	$(document).ready(function () {
		$('.note-editable').addClass('body');
		$(window).scroll(function () {
			$('.fadeIn, .fadeInUp, .fadeInDown, .fadeInRight, .fadeInLeft').each(function () {
				let position = $(this).offset().top;
				let topPosition = $(window).scrollTop() + $(window).height();
				if (position < topPosition) {
					$(this).addClass('visible');
				}
			});
		});
	});
</script>