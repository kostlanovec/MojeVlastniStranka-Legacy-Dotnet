@page
@model MojeVlastniStranka.Web.Pages.blog.IndexModel
@{
	ViewData["Title"] = "Blog";
	ViewData["Description"] = "Blog příspěvky Jana Sebastiána Kostlána. Tvůrce, webdesigner, programátor a marketing maestro skrz SEO.";
	ViewData["Author"] = "Jan Sebastián Kostlán";
	ViewData["Keywords"] = "blog, osobní";
}

<header>
	<h1>Blog</h1>
	<input class="searchbar" type="text" placeholder="hledat"/>
	<div id="results"></div>
</header>

<main class="main">
  <h2>Odbornější články</h2>
	<section>
		@for (var i = 0; i < Model.Posts.Count; i++)
		{
			<article class="article__blog @(i == 0 ? "first__item" : i == 1 ? "second__item" : i == 2 ? "third__item" : "item")">
				<a href="/blog/@Model.Posts[i].Slug">
					<img src="@Model.Posts[i].FilePath">
					<p class="text__for__img">@Model.Posts[i].Name</p>
				</a>
			</article>
		}
	</section>

</main>

<script>
	$(document).ready(function() {
		$('#searchBox').keyup(function() {
			var query = $(this).val();
			if (query.length > 2) { // Vyhledávání začne po zadání 3 znaků
				$.ajax({
					url: '/api/search',
					data: { 'query': query },
					success: function(data) {
						$('#results').empty();
						data.forEach(function(article) {
							$('#results').append('<p><strong>' + article.title + '</strong> - ' + article.content + '</p>');
						});
					}
				});
			} else {
				$('#results').empty();
			}
		});
	});
</script>