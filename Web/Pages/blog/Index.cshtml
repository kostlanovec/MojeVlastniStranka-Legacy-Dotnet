@page
@model MojeVlastniStranka.Web.Pages.blog.IndexModel
@{
}

<header class="header__other fadeInLeft visible">
	<h1 class="header__h1">Blog</h1>
	<p class="header__p">Osobní blog, kde se dozvíte o mých pohnutkách, zájmech a pohnutkách. <span class="span__header__p">Ne pro každého je tohle čtení.</span></p>
</header>

<main class="main">
  <h2 class="h2__blog fadeInUp visible">Odbornější články</h2>
  <section class="section__blog fadeInUp visible">
    @for (var i = 0; i < Model.Posts.Count; i++)
    {
      <article class="article__blog @(i == 0 ? "first__item" : i == 1 ? "second__item" : i == 2 ? "third__item" : "item")">
        <a href="/blog/@Model.Posts[i].Slug">
          <img src="images/@Model.Posts[i].FilePath" alt="@Model.Posts[i].Description">
          <p class="text__for__img">@Model.Posts[i].Name</p>
        </a>
      </article>
    }
  </section>
</main>
