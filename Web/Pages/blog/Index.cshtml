@page
@model MojeVlastniStranka.Web.Pages.blog.IndexModel
@{
	ViewData["Title"] = "Blog";
	ViewData["Description"] = "Blog příspěvky Jana Sebastiána Kostlána. Tvůrce, webdesigner, programátor a marketing maestro skrz SEO.";
	ViewData["Author"] = "Jan Sebastián Kostlán";
	ViewData["Keywords"] = "blog, osobní";
}
@using MojeVlastniStranka.Common.Extension

<main class="main">
	<header class="reveal">
		<h1>Blog</h1>
			<input class="searchbar" type="text" placeholder="hledat" />
		<div id="results"></div>
	</header>
    @foreach (var category in Model.CategoriesWithPosts)
    {
        <section class="reveal">
            <h2 class="blog__h2">@category.Name</h2>
            <div class="div--blog--articles">
                @{
                    bool isFirstPost = true;
                }
                @foreach (var post in category.BlogPosts)
                {
                    if (isFirstPost)
                    {
                        <article class="article--first--post zoom-effect">
                            <a class="blog--a" href="/Blog/@post.Slug">
                                <h3 class="blog__first__h3">@post.Name</h3>
                                <img src="@post.FilePath" alt="@post.Name" />
                            </a>
                        </article>
                        isFirstPost = false;
                    }
                    else
                    {
                        <article class="article--post zoom-effect">
                            <a class="blog--a blog--a--other" href="/Blog/@post.Slug">
                                <img src="@post.FilePath" alt="@post.Name" />
                                <div class="blog--div">
                                    <h3 class="blog__h3">@post.Name</h3>
                                    <div class="blog--data">
                                        <p>@post.Description</p>
                                        <p>@post.TimePublic.ToCzechDate()</p>
                                    </div>
                                </div>

                            </a>
                        </article>
                    }
                }
            </div>
        </section>
    }
	</>
</main>
