@page
@model MojeVlastniStranka.Web.Pages.kontakt.kontaktModel
@{
	ViewData["Title"] = "Kontakt";
	ViewData["Description"] = "Kontaktujte mě přes formulář nebo přes sociální sítě. Rád vám poradím s vaším projektem.";
	ViewData["Author"] = "Jan Sebastián Kostlán";
	ViewData["Keywords"] = "Kontakt, formulář, sociální sítě, Jan, Sebastián, Kostlán, SEO, webových, tvůrce, sociální, sítě, sociálních, sítí";
	ViewData["SocialTitle"] = "Kostlanovec - kontakt.";
}
<main class="main">
	<h1 class="center__text reveal">Sociální sítě</h1>
	<div class="socials--buttons reveal">
		<a href="https://www.instagram.com/kostlan1" class="socials--button zoom-effect">
			<img aria-hidden="true" class="social--image" src="./images/icons/instagram.svg" />
			<p class="social--text">@@kostlan</p>
		</a>
		<a href="https://www.linkedin.com/in/kostlan" class="socials--button zoom-effect">
			<img aria-hidden ="true" class="social--image" src="./images/icons/linkedin.svg" />
			<p class="social--text">kostlan</p>
		</a>
		<a href="https://www.youtube.com/@@kostlanovec" class="socials--button zoom-effect">
			<img aria-hidden="true" class="social--image" src="./images/icons/youtubee.svg" />
			<p class="social--text">Kostlanovec</p>
		</a>
		<a href="https://discord.gg/VdSEt8qUXE" class="socials--button zoom-effect">
			<img aria-hidden="true" class="social--image" src="./images/icons/discord.svg" />
			<p class="social--text">Kostlanovec - server</p>
		</a>
		<a href="https://www.facebook.com/jan.sebastiankostlan.1/" class="socials--button zoom-effect">
			<img aria-hidden="true" class="social--image" src="./images/icons/facebook.svg" />
			<p class="social--text">Jan Sebastián Kostlán</p>
		</a>
	</div>
	<h1 class="center__text reveal">Formulář</h1>
	<p class="form--text reveal">Máš zájem o spolupraci, máš na něco otázku? Neváhej mi napsat!</p>
	<form class="contact__form reveal" method="post">
		<input class="input__form" type="email" name="Form.Email" placeholder="Email" required><br>
		<input class="input__form" type="text" name="Form.PhoneNumber" placeholder="Telefon"><br>
		<textarea class="textarea__form" name="Form.Message" cols="30" rows="10" placeholder="Dobrý den, mám zájem o / mám dotaz na" required></textarea><br>
		<input type="text" name="Honeypot" style="display:none" tabindex="-1" autocomplete="off"><br>
		<button class="button form--button" type="submit">Odeslat</button>
	</form>
</main>