@page
@model MojeVlastniStranka.Web.Pages.IndexModel
@using Microsoft.AspNetCore.Mvc.Localization
@using MojeVlastniStranka.Web
@inject IHtmlLocalizer<SharedResource> SharedLocalizer
@{
    ViewData["Title"] = SharedLocalizer["IndexTitle"];
    ViewData["Description"] = SharedLocalizer["IndexDesc"];
    ViewData["Author"] = "Jan Sebastián Kostlán";
    ViewData["Keywords"] = SharedLocalizer["IndexKeywords"];
    ViewData["Image"] = "https://kostlanovec.cz/images/basicimage.png";
    ViewData["SocialTitle"] = SharedLocalizer["IndexSocialTitle"];

    ViewData["JsonLD"] = $@"
    {
      ""@context"": ""https://schema.org"",
      ""@graph"": [
        {
          ""@type"": ""WebSite"",
          ""@id"": ""https://kostlanovec.cz/#website"",
          ""url"": ""https://kostlanovec.cz/"",
          ""name"": ""{SharedLocalizer["IndexSocialTitle"]}"",
          ""description"": ""{SharedLocalizer["IndexDesc"]}"",
          ""publisher"": {{ ""@id"": ""https://kostlanovec.cz/#person"" }},
          ""inLanguage"": ""{System.Globalization.CultureInfo.CurrentCulture.Name}""
        },
        {
          ""@type"": ""Person"",
          ""@id"": ""https://kostlanovec.cz/#person"",
          ""name"": ""Jan Sebastián Kostlán"",
          ""url"": ""https://kostlanovec.cz/"",
          ""image"": ""https://kostlanovec.cz/images/basicimage.png"",
          ""description"": ""{SharedLocalizer["SubTitle"]}"",
          ""jobTitle"": ""{SharedLocalizer["IndexTitle"]}"",
          ""sameAs"": [
            ""https://www.instagram.com/kostlan1"",
            ""https://www.linkedin.com/in/kostlan"",
            ""https://www.youtube.com/@kostlanovec"",
            ""https://discord.gg/VdSEt8qUXE"",
            ""https://www.facebook.com/jan.sebastiankostlan.1/""
          ]
        },
        {
          ""@type"": ""ContactPage"",
          ""@id"": ""https://kostlanovec.cz/kontakt#contact"",
          ""url"": ""https://kostlanovec.cz/kontakt"",
          ""inLanguage"": ""{System.Globalization.CultureInfo.CurrentCulture.Name}"",
          ""name"": ""{SharedLocalizer["Kontakt"]} – Jan Sebastián Kostlán"",
          ""about"": {{ ""@id"": ""https://kostlanovec.cz/#person"" }}
        }
      ]
    }";
}

<main class="main">
    <header class="header header--index reveal">
        <link rel="preload" as="image" href="/images/website_image.svg" type="image/svg+xml">
        <figure class="header--figure">
            <img class="header--figure--image"
                 src="/images/website_image.svg"
                 alt="@SharedLocalizer["IndexSocialTitle"]"
                 width="400" height="400"
                 fetchpriority="high" decoding="async">
        </figure>
        <div>
            <h1>Jan Sebastián Kostlán</h1>
            <p class="p--index">@SharedLocalizer["SubTitle"]</p>
            <button id="scrollBtn" aria-label="Přejít na služby" class="arrow"></button>
        </div>
    </header>

    <div id="target" class="services reveal">
        <h2>@SharedLocalizer["Services"]</h2>
        <section class="scrolling__container" id="scrollContainer">
            <article class="scrolling__article reveal">
                <a class="scrolling__article__a" asp-page="./sluzby/webovestranky">
                    <img src="/images/webovestranky.jpg" alt="@SharedLocalizer["WebDevelopment"]" loading="lazy" decoding="async">
                    <div class="scrolling__article--div">
                        <h3>@SharedLocalizer["WebDevelopment"]</h3>
                    </div>
                </a>
            </article>
            <article class="scrolling__article reveal">
                <a class="scrolling__article__a" asp-page="./sluzby/tvorbaher">
                    <img src="/images/tvorbaher.jpg" alt="@SharedLocalizer["GameDevelopment"]" loading="lazy" decoding="async">
                    <div class="scrolling__article--div">
                        <h3>@SharedLocalizer["GameDevelopment"]</h3>
                    </div>
                </a>
            </article>
            <article class="scrolling__article reveal">
                <a class="scrolling__article__a" asp-page="./sluzby/socialnisite">
                    <img src="/images/socialnisite.jpg" alt="@SharedLocalizer["SocialMedia"]" loading="lazy" decoding="async">
                    <div class="scrolling__article--div">
                        <h3>@SharedLocalizer["SocialMedia"]</h3>
                    </div>
                </a>
            </article>
            <article class="scrolling__article reveal">
                <a class="scrolling__article__a" asp-page="./sluzby/seo">
                    <img src="/images/seo.jpg" alt="@SharedLocalizer["SEO"]" loading="lazy" decoding="async">
                    <div class="scrolling__article--div">
                        <h3>@SharedLocalizer["SEO"]</h3>
                    </div>
                </a>
            </article>
        </section>
    </div>

    <section class="menu--blogposts reveal" aria-labelledby="blog-title">
        <h2 id="blog-title">@SharedLocalizer["Blog"]</h2>
        <div class="wrapper" role="region" aria-roledescription="carousel" aria-label="Blog příspěvky">
            <div class="slides">
                @for (int i = 0; i < Model.Posts.Count; i++)
                {
                    var post = Model.Posts.ElementAt(i);

                    if (i == 0)
                    {
                        <div id="blog-slide-@i"
                             role="tabpanel"
                             aria-labelledby="blog-tab-@i"
                             tabindex="0">
                            <a href="/blog/@post.Slug" class="figure__blog">
                                <img src="@post.FilePath"
                                     alt="@post.Name"
                                     loading="lazy" decoding="async" />
                                <div class="figure__blog__div">
                                    <h3>@post.Name</h3>
                                    <p>@post.Description</p>
                                </div>
                            </a>
                        </div>
                    }
                    else
                    {
                        <div id="blog-slide-@i"
                             role="tabpanel"
                             aria-labelledby="blog-tab-@i"
                             tabindex="0"
                             hidden>
                            <a href="/blog/@post.Slug" class="figure__blog">
                                <img src="@post.FilePath"
                                     alt="@post.Name"
                                     loading="lazy" decoding="async" />
                                <div class="figure__blog__div">
                                    <h3>@post.Name</h3>
                                    <p>@post.Description</p>
                                </div>
                            </a>
                        </div>
                    }
                }
            </div>
            <div class="pagination" role="tablist" aria-label="Přepínače článků">
                @for (int i = 0; i < Model.Posts.Count; i++)
                {
                    <button class="behind--dot"
                            id="blog-tab-@i"
                            role="tab"
                            type="button"
                            aria-selected="@(i == 0 ? "true" : "false")"
                            aria-controls="blog-slide-@i">
                        <span class="dot" aria-hidden="true"></span>
                    </button>
                }
            </div>
        </div>
    </section>

    <section class="aboutme__Card reveal" aria-labelledby="about-title">
        <div class="aboutme__Card__images">
            <img src="/images/osobnifotka.jpg" alt="@SharedLocalizer["IndexSocialTitle"]" loading="lazy" decoding="async" class="profilepicture">
            <img class="megafone"
                 src="/images/icons/megafon.svg"
                 alt=""
                 aria-hidden="true"
                 loading="lazy"
                 decoding="async">
        </div>
        <div class="aboutme__text">
            <h2 id="about-title">@SharedLocalizer["AboutMeTitle"]</h2>
            <p>@SharedLocalizer["AboutMeP1"]</p>
            <p>@SharedLocalizer["AboutMeP2"]</p>
            <p>@SharedLocalizer["AboutMeP3"]</p>
            <p>@SharedLocalizer["AboutMeP4"]</p>
            <p>@SharedLocalizer["AboutMeP5"]</p>
            <p>@SharedLocalizer["AboutMeP6"]</p>
        </div>
    </section>
</main>

<form class="form__newsletter reveal" method="post">
    <h2>@SharedLocalizer["NewsletterTitle"]</h2>
    <img class="email__ikonka" src="/images/icons/emailikonka.svg" alt="" aria-hidden="true" loading="lazy" decoding="async">
    <p>@SharedLocalizer["NewsletterDesc"]</p>
    <input type="email" asp-for="email" placeholder="@SharedLocalizer["EmailPlaceholder"]" required class="input__email" aria-describedby="newsletter-help">
    <span id="newsletter-help" class="sr-only">Zadej svůj e-mail, abys mohl(a) odebírat novinky.</span>
    <span asp-validation-for="email" class="text-danger"></span>
    <button aria-label="Odeslat přihlášení do newsletteru" class="button" type="submit">@SharedLocalizer["Submit"]</button>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="success-message">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (ModelState.ErrorCount > 0)
    {
        <div class="error-message">
            @ModelState.Values.SelectMany(v => v.Errors).FirstOrDefault()?.ErrorMessage
        </div>
    }
</form>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const AUTOPLAY_MS = 5000;
        const SWIPE_THRESHOLD = 40;
        const panels = Array.from(document.querySelectorAll('[role="tabpanel"]'));
        const tabs = Array.from(document.querySelectorAll('[role="tab"]'));
        if (!panels.length || !tabs.length) return;

        let currentIndex = 0;
        let autoplayTimer = null;
        const swipeArea = document.querySelector(".slides");

        function show(i) {
            i = (i + panels.length) % panels.length;
            panels.forEach((p, x) => p.hidden = x !== i);
            tabs.forEach((t, x) => {
                const sel = x === i;
                t.setAttribute("aria-selected", sel);
                t.tabIndex = sel ? 0 : -1;
                const dot = t.querySelector(".dot");
                if (dot) dot.classList.toggle("active", sel);
            });
            currentIndex = i;
        }

        function next() { show(currentIndex + 1); }
        function prev() { show(currentIndex - 1); }

        function startAutoplay() {
            clearInterval(autoplayTimer);
            autoplayTimer = setInterval(next, AUTOPLAY_MS);
        }

        function userInteracted() {
            clearInterval(autoplayTimer);
            setTimeout(startAutoplay, 2000);
        }

        show(0);
        startAutoplay();

        tabs.forEach((tab, i) => {
            tab.addEventListener("click", () => { show(i); userInteracted(); });
            tab.addEventListener("keydown", (e) => {
                if (e.key === "ArrowRight") { next(); e.preventDefault(); }
                if (e.key === "ArrowLeft") { prev(); e.preventDefault(); }
            });
        });

        let down = false, startX = 0, moved = 0;
        swipeArea.addEventListener("pointerdown", e => {
            down = true;
            startX = e.clientX;
            moved = 0;
        }, { passive: true });

        swipeArea.addEventListener("pointermove", e => {
            if (!down) return;
            moved = e.clientX - startX;
        }, { passive: true });

        swipeArea.addEventListener("pointerup", () => {
            if (!down) return;
            down = false;
            if (Math.abs(moved) > SWIPE_THRESHOLD) {
                if (moved < 0) next(); else prev();
                userInteracted();
            }
        }, { passive: true });
    });
</script>
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const sc = document.getElementById("scrollContainer");
        if (!sc) return;

        let down = false, startX = 0, scrollStart = 0;

        sc.addEventListener("pointerdown", e => {
            down = true;
            startX = e.clientX;
            scrollStart = sc.scrollLeft;
            sc.classList.add("grabbing");
        }, { passive: true });

        sc.addEventListener("pointermove", e => {
            if (!down) return;
            const x = e.clientX;
            sc.scrollLeft = scrollStart - (x - startX);
        }, { passive: true });

        sc.addEventListener("pointerup", () => {
            down = false;
            sc.classList.remove("grabbing");
        }, { passive: true });

        sc.addEventListener("pointerleave", () => {
            down = false;
            sc.classList.remove("grabbing");
        }, { passive: true });

        sc.addEventListener("wheel", e => {
            if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) {
                sc.scrollLeft += e.deltaX;
                e.preventDefault();
            }
        }, { passive: false });
    });
</script>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const btn = document.getElementById("scrollBtn");
        const target = document.getElementById("target");
        if (!btn || !target) return;
        btn.addEventListener("click", () => {
            target.scrollIntoView({ behavior: "smooth" });
        });
    });
</script>
