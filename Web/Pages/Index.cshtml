@page
@model MojeVlastniStranka.Web.Pages.IndexModel
@{
	ViewData["Title"] = "Hlavní stránka";
	ViewData["Description"] = "Osobní stránka Jana Sebastiána Kostlána. Tvůrce, webdesigner, programátor a marketing maestro skrz SEO.";
	ViewData["Author"] = "Jan Sebastián Kostlán";
	ViewData["Keywords"] = "Weby, aplikace, Jan, Sebastián, Kostlán, SEO, webových, tvůrce, sociální, sítě, sociálních, sítí";
	ViewData["Image"] = "https://kostlanovec.cz/images/basicimage.png";
	ViewData["SocialTitle"] = "Osobní stránka Jana Sebastiána Kostlána";
}

<main class="main">
	<header class="header header--index reveal">
		<link rel="preload" as="image" href="/images/website_image.svg" type="image/svg+xml">
		<figure class="header--figure">
			<img class="header--figure--image"
				  src="/images/website_image.svg"
				  alt="Kostlanovec – osobní web Jana Sebastiána Kostlána"
				  width="400" height="400"
				  fetchpriority="high" decoding="async">
		</figure>
		<div>
			<h1>Jan Sebastián Kostlán</h1>
			<p class="p--index">Tvůrce webů, her, seo maestro a student, který je zarytým "ajťákem".</p>
			<button id="scrollBtn" aria-label="Šipka pro scrollování" class="arrow"></button>
		</div>
	</header>
	<div id="target" class="services reveal">
		<h2>Nabízené služby</h2>
		<section class="scrolling__container" id="scrollContainer">
			<article class="scrolling__article reveal">
				<a class="scrolling__article__a" asp-page="./sluzby/webovestranky">
					<img src="images/webovestranky.jpg" alt="Webové stránky" loading="lazy" decoding="async">
					<div class="scrolling__article--div">
						<h3>Webové stránky</h3>
					</div>
				</a>
			</article>
			<article class="scrolling__article reveal">
				<a class="scrolling__article__a" asp-page="./sluzby/tvorbaher">
					<img src="images/tvorbaher.jpg" alt="Unity logo" loading="lazy" decoding="async">
					<div class="scrolling__article--div">
						<h3>Tvorba her</h3>
					</div>
				</a>
			</article>
			<article class="scrolling__article reveal">
				<a class="scrolling__article__a" asp-page="./sluzby/socialnisite">
					<img src="images/socialnisite.jpg" alt="Obrázek planety skrz sociální sítě" loading="lazy" decoding="async">
					<div class="scrolling__article--div">
						<h3>Správa sociálních sítí</h3>
					</div>
				</a>
			</article>
			<article class="scrolling__article reveal">
				<a class="scrolling__article__a" asp-page="./sluzby/seo">
					<img src="images/seo.jpg" alt="text seo s lupou" loading="lazy" decoding="async">
					<div class="scrolling__article--div">
						<h3>Optimalizace SEO</h3>
					</div>
				</a>
			</article>
		</section>
	</div>
	<div class="menu--blogposts reveal">
		<h2>Blog příspěvky</h2>
		<div class="wrapper" aria-roledescription="carousel" aria-label="Blog příspěvky">
			<div class="slides">
				@for (int i = 0; i < Model.Posts.Count(); i++)
				{
					var post = Model.Posts.ElementAt(i);

					if (i == 0)
					{
						<div id="blog-slide-@i"
							  role="tabpanel"
							  aria-labelledby="blog-tab-@i"
							  tabindex="0">
							<a href="/blog/@post.Slug" class="figure__blog">
								<img src="@post.FilePath"
									  alt="@post.Name"
									  loading="lazy" decoding="async" />

								<div class="figure__blog__div">
									<h3>@post.Name</h3>
									<p>@post.Description</p>
								</div>
							</a>
						</div>
					}
					else
					{
						<div id="blog-slide-@i"
							  role="tabpanel"
							  aria-labelledby="blog-tab-@i"
							  tabindex="0"
							  hidden>
							<a href="/blog/@post.Slug" class="figure__blog">
								<img src="@post.FilePath"
									  alt="@post.Name"
									  loading="lazy" decoding="async" />

								<div class="figure__blog__div">
									<h3>@post.Name</h3>
									<p>@post.Description</p>
								</div>
							</a>
						</div>
					}
				}
			</div>

			<div class="pagination" role="tablist" aria-label="Přepínače článků">
				@for (int i = 0; i < Model.Posts.Count(); i++)
				{
					<button class="behind--dot"
							  id="blog-tab-@i"
							  role="tab"
							  type="button"
							  aria-selected="@(i == 0 ? "true" : "false")"
							  aria-controls="blog-slide-@i">
						<span class="dot" aria-hidden="true"></span>
						<span class="sr-only">Zobrazit článek @(i + 1)</span>
					</button>
				}
			</div>
		</div>
</div>
	<div class="aboutme__Card reveal">
		<div class="aboutme__Card__images">
			<img src="images/osobnifotka.jpg" alt="Blog" loading="lazy" decoding="async" class="profilepicture">
			<img class="megafone" src="images/icons/megafon.svg" aria-hidden="true" alt="Megafon" loading="lazy" decoding="async">
		</div>
		<div class="aboutme__text">
			<h2>Něco o mně</h2>
			<p>Zdravím, jmenuji se <strong>Jan Sebastián Kostlán</strong> a jsem vášnivý tvůrce webových aplikací, her, SEO maestro a technologický nadšenec, Věřím, že technologie nám usnadňují každodenní život a jsou klíčové jako nástroj pro osobní a profesní růst , a proto se zaměřuji na vytváření inovativních řešení. Při svém volnu, pokud netluču do klávesnice, tak se věnuji fitness převážně fitku a boxu. Mým cílem je budovat aplikace, hry, a celkově všechno možné, čemu věřím, že má smysl se tím zabývat. Pokud vás zajímavý konkrétní projekty, kterým se momentálně věnuji, tak doporučuji navštívit sekci <a href="/projekty" target="_blank" rel="noopener">Projekty</a>.</p>
		</div>
	</div>
</main>
<form class="form__newsletter reveal" method="post">
	<h2>Buď v obraze</h2>
	<img class="email__ikonka" src="images/icons/emailikonka.svg" alt="Email ikona" aria-hidden="true" loading="lazy" decoding="async">
	<p>Chceš dostávat pravidelné newslettery o tom, co plánuji a co píšu. Nezapomeň vyplnit email.</p>
	<input type="email" asp-for="email" placeholder="E-mail" required class="input__email" aria-describedby="newsletter-help">
	<span asp-validation-for="email" class="text-danger"></span>
	<button aria-label="Tlačítko odeslání" class="button" type="submit">Odeslat</button>

	@if (TempData["SuccessMessage"] != null)
	{
		<div class="success-message">
			@TempData["SuccessMessage"]
		</div>
	}

	@if (ModelState.ErrorCount > 0)
	{
		<div class="error-message">
			@ModelState.Values.SelectMany(v => v.Errors).FirstOrDefault()?.ErrorMessage
		</div>
	}
</form>

<script>
	document.addEventListener("DOMContentLoaded", function () {
	  let currentIndex = 0;
	  const panels = document.querySelectorAll('[role="tabpanel"]');
	  const tabs = document.querySelectorAll('[role="tab"]');
	  let autoAdvanceTimer;

	  function show(index) {
		 panels.forEach((p, i) => {
			if (i === index) {
			  p.removeAttribute('hidden');
			} else {
			  p.setAttribute('hidden', '');
			}
		 });
		 tabs.forEach((t, i) => {
			t.setAttribute('aria-selected', i === index ? 'true' : 'false');
			t.tabIndex = i === index ? 0 : -1;
		 });
		 currentIndex = index;
	  }

	  function next() {
		 show((currentIndex + 1) % panels.length);
	  }

	  function startAuto() { autoAdvanceTimer = setInterval(next, 5000); }
	  function resetAuto() { clearInterval(autoAdvanceTimer); startAuto(); }

	  show(0);
	  startAuto();

	  tabs.forEach((tab, i) => {
		 tab.addEventListener('click', () => { show(i); resetAuto(); });
		 tab.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowRight') { show((i + 1) % tabs.length); e.preventDefault(); }
			if (e.key === 'ArrowLeft') { show((i - 1 + tabs.length) % tabs.length); e.preventDefault(); }
		 });
	  });
	});
</script>

<script>
	const scrollContainer = document.getElementById('scrollContainer');
	let isScrolling = false;
	let startX;
	let scrollLeft;
	scrollContainer.addEventListener('mousedown', function (e) {
		isScrolling = true;
		startX = e.pageX - scrollContainer.offsetLeft;
		scrollLeft = scrollContainer.scrollLeft;
	});
	scrollContainer.addEventListener('mousemove', function (e) {
		if (!isScrolling) return;
		const x = e.pageX - scrollContainer.offsetLeft;
		const scrollBy = x - startX;
		scrollContainer.scrollLeft = scrollLeft - scrollBy;
	});
	scrollContainer.addEventListener('mouseup', function () {
		isScrolling = false;
	});
	scrollContainer.addEventListener('mouseleave', function () {
		isScrolling = false;
	});
</script>