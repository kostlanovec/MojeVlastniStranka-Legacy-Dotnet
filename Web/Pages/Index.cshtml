@page
@model MojeVlastniStranka.Web.Pages.IndexModel
@{
	ViewData["Title"] = "Hlavní strana";
	ViewData["Description"] = "Osobní stránka Jana Sebastiána Kostlána. Tvůrce, webdesigner, programátor a marketing maestro skrz SEO.";
	ViewData["Author"] = "Jan Sebastián Kostlán";
	ViewData["Keywords"] = "Weby, aplikace, Jan, Sebastián, Kostlán, SEO, webových, tvůrce, sociální, sítě, sociálních, sítí";
}

<main class="main">
	<header class="header header--index">
		<figure class="header--figure">
			<img class="header--figure--image" src="images/website_image.svg" alt="Kostlanovec">
		</figure>
		<div>
			<h1 class="h1--index">Jan Sebastián Kostlán</h1>
			<p class="p--index">Tvůrce webů, her a student, který se zajímá o softwarový vývoj. Zajímá se taktéž o vědu jako celek.</p>
			<button id="scrollBtn" class="arrow"></button>
		</div>
	</header>
	<div id="target" class="services">
		<h2>Nabízené služby</h2>
		<section class="scrolling__container" id="scrollContainer">
			<article class="scrolling__article">
				<a class="scrolling__article__a" asp-page="./sluzby/webovestranky">
					<img src="images/webovestranky.jpg" alt="Webové stránky">
					<div class="scrolling__article--div">
						<h3>Webové stránky</h3>
					</div>
				</a>
			</article>
			<article class="scrolling__article">
				<a class="scrolling__article__a" asp-page="./sluzby/tvorbaher">
					<img src="images/tvorbaher.jpg" alt="Unity logo">
					<div class="scrolling__article--div">
						<h3>Tvorba her</h3>
					</div>
					</a>
			</article>
			<article class="scrolling__article">
				<a class="scrolling__article__a" asp-page="./sluzby/socialnisite">
				<img src="images/socialnisite.jpg" alt="Obrázek planety skrz sociální sítě">
				<div class="scrolling__article--div">
						<h3>Správa sociálních sítí</h3>
					</div>
					</a>
			</article>
			<article class="scrolling__article">
				<a class="scrolling__article__a" asp-page="./sluzby/seo">
				<img src="images/seo.jpg" alt="text seo s lupou">
				<div class="scrolling__article--div">
						<h3>Optimalizace SEO</h3>
					</div>
					</a>
			</article>
		</section>
	</div>
	<div>
		<h2>Blog příspěvky</h2>
		<div class="wrapper">
			<div class="slide">
				@foreach (var post in Model.Posts)
				{
					<figure class="figure__blog">
						<img src="@post.FilePath" alt="Blog">
						<div class="figure__blog__div">
							<h3>@post.Name</h3>
							<p>@post.Description</p>
						</div>
					</figure>
				}
			</div>
			<div class="pagination">
				<span class="behind--dot"><span class="dot"></span></span>
				<span class="behind--dot"><span class="dot"></span></span>
				<span class="behind--dot"><span class="dot"></span></span>
			</div>
		</div>
	</div>
	<div class="aboutme__Card">
		<div class="aboutme__Card__images">
			<img src="images/osobnifotka.png" alt="Blog">
			<img class="megafone" src="images/icons/megafon.svg" aria-hidden="true" alt="Megafon">
		</div>
		<div class="aboutme__text">
			<h2>Něco o mně</h2>
			<p>Zdravím, jsem Jan Sebastián Kostlán, programátor a tvůrce webových aplikací. Nesmírně si užívám volnost při programování. Ve svém volnu, pokud neprogramuji, tak se věnuji fitness, protože věřím, že každý by měl se sebou něco dělat a to nejen fyzicky, ale i intelektuálně. Učit se každý den nových dovedností. Baví mě pracovat na věcech ve kterých věřím, že mají smysl a jsou prospěšné pro ostatní lidi a mne samotného.</p>
		</div>
	</div>

</main>


<form class="form__newsletter" method="post">
	<h2>Buď v obraze</h2>
	<img class="email__ikonka" src="images/icons/emailikonka.svg" alt="Email ikona" aria-hidden="true">
	<p>Chceš dostávat pravidelné newslettery o tom, co plánuji a co píšu. Nezapomeň vyplnit email.</p>
	<input type="email" name="email" placeholder="E-mail" required class="input__email">
	<button class="button" type="submit">Odeslat</button>
</form>

<script>
	document.addEventListener("DOMContentLoaded", function () {
		let currentIndex = 0;
		const figures = document.querySelectorAll(".figure__blog");
		const dots = document.querySelectorAll(".dot");
		let autoAdvanceTimer;

		function hideAllFigures() {
			figures.forEach(function (figure) {
				figure.style.display = "none";
			});
		}

		function removeActiveClassFromDots() {
			dots.forEach(function (dot) {
				dot.classList.remove("active");
			});
		}

		function showFigure(index) {
			hideAllFigures();
			removeActiveClassFromDots();
			figures[index].style.display = "flex";
			dots[index].classList.add("active");
		}

		function toggleFigure() {
			currentIndex++;
			if (currentIndex >= figures.length) {
				currentIndex = 0;
			}
			showFigure(currentIndex);
		}

		function startAutoAdvance() {
			autoAdvanceTimer = setInterval(toggleFigure, 5000);
		}

		function resetAutoAdvance() {
			clearInterval(autoAdvanceTimer);
			startAutoAdvance();
		}

		showFigure(0);
		startAutoAdvance();

		dots.forEach(function (dot, index) {
			dot.addEventListener('click', function () {
				currentIndex = index;
				showFigure(currentIndex);
				resetAutoAdvance();
			});
		});

		document.getElementById("scrollBtn").addEventListener("click", function () {
			const targetElement = document.getElementById("target");
			targetElement.scrollIntoView({ behavior: "smooth" });
		});
	});


</script>

<script>
	const scrollContainer = document.getElementById('scrollContainer');

	let isScrolling = false;
	let startX;
	let scrollLeft;

	scrollContainer.addEventListener('mousedown', function (e) {
		isScrolling = true;
		startX = e.pageX - scrollContainer.offsetLeft;
		scrollLeft = scrollContainer.scrollLeft;
	});

	scrollContainer.addEventListener('mousemove', function (e) {
		if (!isScrolling) return;
		const x = e.pageX - scrollContainer.offsetLeft;
		const scrollBy = x - startX;
		scrollContainer.scrollLeft = scrollLeft - scrollBy;
	});

	scrollContainer.addEventListener('mouseup', function () {
		isScrolling = false;
	});

	scrollContainer.addEventListener('mouseleave', function () {
		isScrolling = false;
	});
</script>