@page
@model MojeVlastniStranka.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Webdeveloper, programátor & SEO specialista";
    ViewData["Description"] = "Tvořím rychlé webové stránky, aplikace a SEO řešení. Webdeveloper a SEO specialista zaměřený na výkon, použitelnost a výsledky.";
    ViewData["Author"] = "Jan Sebastián Kostlán";
    ViewData["Keywords"] ="Jan Sebastián Kostlán, webdeveloper, SEO specialista, tvorba webových stránek, optimalizace webu, výkonné weby";
    ViewData["Image"] = "https://kostlanovec.cz/images/basicimage.png";
    ViewData["SocialTitle"] = "Jan Sebastián Kostlán – webdeveloper & SEO";

    ViewData["JsonLD"] = @"
    {
      ""@context"": ""https://schema.org"",
      ""@graph"": [
        {
          ""@type"": ""WebSite"",
          ""@id"": ""https://kostlanovec.cz/#website"",
          ""url"": ""https://kostlanovec.cz/"",
          ""name"": ""Jan Sebastián Kostlán – webdeveloper & SEO"",
          ""description"": ""Osobní web Jana Sebastiána Kostlána – webdeveloper, programátor, webdesigner a SEO specialista. Projekty, blog a kontakt."",
          ""publisher"": { ""@id"": ""https://kostlanovec.cz/#person"" },
          ""inLanguage"": ""cs""
        },
        {
          ""@type"": ""Person"",
          ""@id"": ""https://kostlanovec.cz/#person"",
          ""name"": ""Jan Sebastián Kostlán"",
          ""url"": ""https://kostlanovec.cz/"",
          ""image"": ""https://kostlanovec.cz/images/basicimage.png"",
          ""description"": ""Webdeveloper, programátor, webdesigner a SEO specialista. Tvořím weby, hry a aplikace – s důrazem na výkon, přístupnost a marketing."",
          ""jobTitle"": ""Webdeveloper, programátor, marketing & SEO"",
          ""sameAs"": [
            ""https://www.instagram.com/kostlan1"",
            ""https://www.linkedin.com/in/kostlan"",
            ""https://www.youtube.com/@kostlanovec"",
            ""https://discord.gg/VdSEt8qUXE"",
            ""https://www.facebook.com/jan.sebastiankostlan.1/""
          ]
        },
