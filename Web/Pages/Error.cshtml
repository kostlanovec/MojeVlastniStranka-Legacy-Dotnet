@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
	Layout = null;
}

<h1 class="text-danger">Chyba :(</h1>
<h2 class="text-danger">Nastala chyba, když jsme zpracovávali tvůj request..</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

<p>Napiš mi o tomto erroru na tento email <a href="mailto:info@kostlanovec.cz">info@kostlanovec.cz</a></p>