@model MojeVlastniStranka.Common.Models.ResponseViewModel

@if (Model != null)
{
    var alertClass = Model.IsSuccess ? "alert-success" : "alert-danger";
    var alertTitle = Model.IsSuccess ? "Úspěch:" : "Chyby:";

    <div class="alert @alertClass alert-dismissible face show" role="alert" bin_skin_checked="1">
        <i class="fa fa-exclamation-circle me-2"></i>

        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        <strong>@alertTitle</strong>

        @if (Model.IsSuccess && !string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <p>@Model.SuccessMessage</p>
        }

        @if (Model.Errors.Any())
        {
            <ul>
                @foreach (var error in Model.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        }
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}