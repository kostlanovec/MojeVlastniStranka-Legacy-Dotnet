@using System.Threading
@model MojeVlastniStranka.DataAccess.Entities.BlogPost
@{
	bool isEn = Thread.CurrentThread.CurrentCulture.Name.StartsWith("en");
	string title = isEn && !string.IsNullOrEmpty(Model.TitleEn) ? Model.TitleEn : Model.Title;
	string desc = isEn && !string.IsNullOrEmpty(Model.DescriptionEn) ? Model.DescriptionEn : Model.Description;
	string keys = isEn && !string.IsNullOrEmpty(Model.KeywordsEn) ? Model.KeywordsEn : Model.Keywords;
	string name = isEn && !string.IsNullOrEmpty(Model.NameEn) ? Model.NameEn : Model.Name;
	string content = isEn && !string.IsNullOrEmpty(Model.ContentEn) ? Model.ContentEn : Model.Content;

	ViewData["Title"] = title;
	ViewData["Description"] = desc;
	ViewData["Keywords"] = keys;
	ViewData["Author"] = @Model.Author;
	ViewData["Image"] = "https://kostlanovec.cz" + Model.ImagePath;
	ViewData["SocialTitle"] = name;
}
@Html.Raw(content)
<script src="https://kit.fontawesome.com/704ff50790.js" crossorigin="anonymous"></script>
<div class="shared--buttons">
	<p>Budeme rádi za sdílení!</p>
	<div class="share-buttons">
		<a href="https://www.facebook.com/dialog/share?app_id=1552041721475989&display=popup&href=https://kostlanovec.cz/blog/@Model.Slug&redirect_uri=https://kostlanovec.cz/blog/@Model.Slug" class="share-button facebook" target="_blank" rel="noopener noreferrer">
			<i class="fab fa-facebook-f"></i>
		</a>
		<a href="https://x.com/intent/tweet?title=@Model.Name&related=Kostlanovec&url=https://kostlanovec.cz/blog/@Model.Slug" class="share-button twitter" target="_blank" rel="noopener noreferrer">
			<i class="fab fa-x-twitter"></i>
		</a>
		<a href="https://www.linkedin.com/shareArticle?mini=true&url=https://kostlanovec.cz/blog/@Model.Slug" class="share-button linkedin" target="_blank" rel="noopener noreferrer">
			<i class="fab fa-linkedin-in"></i>
		</a>
	</div>
</div>