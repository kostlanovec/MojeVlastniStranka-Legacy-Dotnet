<!-- Formulář -->
@Html.AntiForgeryToken()
@using (Html.BeginForm("SubmitContactForm", "ContactForm", FormMethod.Post, new { id = "kontakt", @class = "form fadeInUp" }))
{
    <article class="article__info__k__form">
        <p class="red">Máte nějaké dotazy?</p>
        <p class="bigger__p">Tak neváhejte a napište mi</p>
        <p class="bigger__p red">Každý dotaz je užitečný!</p>
    </article>

	<div class="div__formular">
		<label>
			<input class="input__form" type="text" name="firstname" placeholder="jméno" required><br>
		</label>
		<label>
			<input class="input__form" type="text" name="lastname" placeholder="příjmení" required><br>
		</label>
		<label>
			<input class="input__form" type="email" name="email" placeholder="email" required><br>
		</label>
		<label>
			<input class="input__form" type="text" name="phonenumber" placeholder="telefon"><br>
		</label>
		<label>
			<textarea class="input__form" name="message" cols="30" rows="10" placeholder="Dobrý den, mám zájem o / mám dotaz na" required></textarea><br>
		</label>
		<div class="div__submit">
			<p class="p__alert">Povinná položka</p>
			<input class="a__classic submit__a" type="submit" value="Odeslat">
		</div>
		<div id="errorMessages" class="alert alert-danger" style="display:none;"></div>
	</div>

	<address class="grid__contacts">
		<a title="telefonní číslo" href="tel:+420987654321" class="contacts__description animation__scale"><span class="icon-dot icon-dot--phone"></span>+420 733 484 242</a>
		<a title="email" href="mailto:info@kostlanovec.cz" class="contacts__description animation__scale"><span class="icon-dot icon-dot--mail"></span>info@kostlanovec.cz</a>
		<a title="linkedin" href="https://www.linkedin.com/in/jan-kostlan-7a9bb4215" class="contacts__description animation__scale"><span class="icon-dot icon-dot--linkedin"></span>Jan Sebastián Kostlán</a>
		<a title="instagram" href="https://www.instagram.com/kostlan1" class="contacts__description animation__scale"><span class="icon-dot icon-dot--instagram"></span>kostlan1</a>
		<a title="github" href="https://github.com/kostlanovec" class="contacts__description animation__scale"><span class="icon-dot icon-dot--github"></span>kostlanovec</a>
	</address>
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        $('#kontakt').on('submit', function (event) {
            event.preventDefault();

            $("#errorMessages").empty().hide();

            $.ajax({
                type: 'POST',
                url: $(this).attr('action'),
                data: $(this).serialize(),
                success: function (response) {
                    if (response.success) {
                        alert(response.message);
                    } else {
                        $.each(response.errors, function (index, error) {
                            $("#errorMessages").append('<p>' + error.memberName + ': ' + error.errorMessage + '</p>');
                        });

                        $("#errorMessages").show();
                    }
                },
                error: function () {
                    $("#errorMessages").append('<p>An unexpected error occurred. Please try again later.</p>');
                    $("#errorMessages").show();
                }
            });
        });
    });
</script>
<style>
    .error-message {
    color: red;
    font-size: 12px;
}
</style>