@page
@model MojeVlastniStranka.Web.Pages.sluzby.webyModel
@{
	ViewData["Title"] = "Weby";
	ViewData["Description"] = "Tvorba webu na míru, kdy si společně definujeme, co chcete od webu a vytvoříme Vám ho na míru. Jan Sebastián Kostlán - Tvůrce, webdesigner, programátor a marketing maestro skrz SEO.";
	ViewData["Author"] = "Jan Sebastián Kostlán";
	ViewData["Keywords"] = "blog, osobní";
}

<header class="header__other fadeInRight visible">
	<h1 class="header__h1">Tvorba webových aplikací</h1>
	<p class="header__p">Tvořím webové stránky na míru.</p>
</header>
<main class="main">
	<article class="fadeInUp visible">
		<h2 class="h2__div__article red">Definování cílů</h2>
		<p>Definujeme si cíle, kterých chceme dosáhnout za pomocí naší stránky</p>
		<h2 class="h2__div__article">Grafický návrh</h2>
		<p>Vytvoříme unikátní design pro vaše webové stránky a vytvoříme společný design.</p>
		<h2 class="h2__div__article">Optimalizace seo</h2>
		<p>Optimalizujeme vaše webové stránky pro lepší zviditelnění ve vyhledávačích.</p>
		<h2 class="h2__div__article">Webhosting a registrace domény</h2>
		<p>Zaregistrujeme hosting a doménu, aby jste vy nemuseli.</p>
		<h2 class="h2__div__article">Pravidelná údržba</h2>
		<p>Pravidelně aktualizujeme váš web, aby byl vždy aktuální.</p>
	</article>
</main>