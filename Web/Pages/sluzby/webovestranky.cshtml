@page
@model MojeVlastniStranka.Web.Pages.sluzby.webovestrankyModel
@{
	ViewData["Title"] = "Weby";
	ViewData["Description"] = "Tvorba webu na míru, kdy si společně definujeme, co chcete od webu a vytvoříme Vám ho na míru. Jan Sebastián Kostlán - Tvůrce, webdesigner, programátor a marketing maestro skrz SEO.";
	ViewData["Author"] = "Jan Sebastián Kostlán";
	ViewData["Keywords"] = "blog, osobní";
}
<header class="header">
	<div>
	<h1>Webové stránky na míru</h1>
	<p>Tvořím webové stránky na míru Vaším potřebám. Stránka je vybavená všemu potřebnému jako je optimalizace SEO (aby lehce byla viditelná ve vyhledávačích), možnosti blog systému, admin panelu, kde se dá trackovat chování uživatelů a přizpůsobonení stránky Vaším potřebám.</p>
	</div>
	<img src="~/images//website_image.svg" />
</header>
<main>
	<article class="service__article">
		<h2>Basic Web</h2>
		<img src="~/images//website_image.svg" />
		<ul class="ul__service">
			<li>Jednostránková stránka</li>
			<li>Základní optimalizace SEO</li>
			<li>Grafický návrh</li>
			<li class="li--x">Admin panel</li>
		</ul>
		<h3>Popis</h3>
		<p>Jednoduchá jednostránková stránka se základními informace pro vaší potřebu. Nejprve probereme spolu požadavky a podle toho toho se sestaví grafický návrh, který se změní podle potřeby, vytvoří se stránka, která se nahraje na nějaký hosting.</p>
		<p>Cena 7997 Kč</p>
		<p>Není započítaná cena domény a hostingu</p>
	</article>
</main>