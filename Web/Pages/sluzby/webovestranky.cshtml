@page
@model MojeVlastniStranka.Web.Pages.sluzby.webovestrankyModel
@{
	ViewData["Title"] = "Weby";
	ViewData["Description"] = "Tvorba webu na míru, kdy si společně definujeme, co chcete od webu a vytvoříme Vám ho na míru. Jan Sebastián Kostlán - Tvůrce, webdesigner, programátor a marketing maestro skrz SEO.";
	ViewData["Author"] = "Jan Sebastián Kostlán";
	ViewData["Keywords"] = "blog, osobní";
}
<main class="main">
	<header class="header header-service">
		<div>
			<h1>Webové stránky na míru</h1>
			<p>Tvořím webové stránky na míru Vaším potřebám. Stránka je vybavená všemu potřebnému jako je optimalizace SEO (aby lehce byla viditelná ve vyhledávačích), možnosti blog systému, admin panelu, kde se dá trackovat chování uživatelů a přizpůsobonení stránky Vaším potřebám.</p>
		</div>
		<img src="~/images/sluzby/SluzbaStranka.svg" />
	</header>
	<article class="service__article">
		<h2 class="service--h2">Basic Web</h2>
		<div class="service--layout">
			<img src="~/images/sluzby/BasicWeb.svg" />
			<ul class="ul__service">
				<li>Jednostránková stránka</li>
				<li>Základní optimalizace SEO</li>
				<li>Grafický návrh</li>
				<li class="li--x">Admin panel</li>
			</ul>
		</div>
		<div>
			<h3>Popis</h3>
			<p class="service--p">Jednoduchá jednostránková stránka se základními informace pro vaší potřebu. Nejprve probereme spolu požadavky a podle toho toho se sestaví grafický návrh, který se změní podle potřeby, vytvoří se stránka, která se nahraje na nějaký hosting.</p>
		</div>
		<div class="serivce--price--div">
			<p class="service--price">Cena 7 997 Kč</p>
			<p class="service--p">Není započítaná cena domény a hostingu</p>
		</div>
	</article>
	<article class="service__article">
		<h2 class="service--h2">Advanced Web</h2>
		<div class="service--layout">
			<ul class="ul__service">
				<li>Vícestránková stránka</li>
				<li>Pokročila optimalizace SEO</li>
				<li>Grafický návrh</li>
				<li>Admin panel</li>
			</ul>
			<img src="~/images/sluzby/AdvancedWeb.svg" />
		</div>
		<div>
			<h3>Popis</h3>
			<p class="service--p">Jednoduchá jednostránková stránka se základními informace pro vaší potřebu. Nejprve probereme spolu požadavky a podle toho toho se sestaví grafický návrh, který se změní podle potřeby, vytvoří se stránka, která se nahraje na nějaký hosting.</p>
		</div>
		<div class="serivce--price--div">
			<p class="service--price">Cena 21 997 Kč</p>
			<p class="service--p">Není započítaná cena domény a hostingu</p>
		</div>
	</article>
	<article class="service__article">
		<h2 class="service--h2">Na míru</h2>
		<div class="service--layout">
			<img src="~/images/sluzby/MegaWeb.svg" />
			<p>Stránka na míru přesně podle vaších potřebách. Společně uděláme odhad, diskuzi ohledně ceny a definujeme si cíle, kterých chceme stránkou - projektem dosáhnout.</p>
		</div>
	</article>
	<h2>Mám zájem o web</h2>
	<form class="contact__form" method="post">
		<select class="input__form">
			<option value="BasicWeb">Basic Web</option>
			<option value="AdvancedWeb">Advanced Web</option>
			<option value="CustomisedWeb">Na míru</option>
		</select>
		<input class="input__form" type="email" name="Email" placeholder="Email" required>
		<input class="input__form" type="text" name="PhoneNumber" placeholder="Telefon">
		<textarea class="textarea__form" name="Message" cols="30" rows="10" placeholder="Dobrý den, mám zájem o / mám dotaz na" required></textarea>
		<button class="button form--button" type="submit">Odeslat</button>
	</form>
</main>