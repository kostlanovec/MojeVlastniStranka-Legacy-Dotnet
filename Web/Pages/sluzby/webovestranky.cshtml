@page
@model MojeVlastniStranka.Web.Pages.sluzby.webovestrankyModel
@{
	ViewData["Title"] = SharedLocalizer["Web_Title"];
	ViewData["Description"] = SharedLocalizer["Web_Desc"];
	ViewData["Author"] = "Jan Sebastián Kostlán";
	ViewData["Keywords"] = SharedLocalizer["Web_Keywords"];
	ViewData["Image"] = "https://kostlanovec.cz/images/webovestranky.jpg";
	ViewData["SocialTitle"] = SharedLocalizer["Web_SocialTitle"];
}
<main class="main">
	<header class="header header-service reveal">
		<div>
			<h1>@SharedLocalizer["Web_H1"]</h1>
			<p>@SharedLocalizer["Web_Intro"]</p>
		</div>
		<img src="~/images/sluzby/SluzbaStranka.svg" />
	</header>
	<article class="service__article reveal">
		<h2 class="service--h2">@SharedLocalizer["Web_BasicH2"]</h2>
		<div class="service--layout">
			<img src="~/images/sluzby/BasicWeb.svg" />
			<ul class="ul__service">
				<li>@SharedLocalizer["Web_BasicUL1"]</li>
				<li>@SharedLocalizer["Web_BasicUL2"]</li>
				<li>@SharedLocalizer["Web_BasicUL3"]</li>
				<li class="li--x">@SharedLocalizer["Web_BasicULX"]</li>
			</ul>
		</div>
		<div>
			<h3>@SharedLocalizer["DescriptionLabel"]</h3>
			<p class="service--p">@SharedLocalizer["Web_BasicDesc"]</p>
		</div>
		<div class="serivce--price--div">
			<p class="service--price">@SharedLocalizer["Web_Price"]</p>
			<p class="service--p">@SharedLocalizer["Web_PriceNote"]</p>
		</div>
	</article>
	<article class="service__article reveal">
		<h2 class="service--h2">@SharedLocalizer["Web_AdvancedH2"]</h2>
		<div class="service--layout">
			<ul class="ul__service">
				<li>@SharedLocalizer["Web_AdvancedUL1"]</li>
				<li>@SharedLocalizer["Web_AdvancedUL2"]</li>
				<li>@SharedLocalizer["Web_AdvancedUL3"]</li>
				<li>@SharedLocalizer["Web_AdvancedUL4"]</li>
			</ul>
			<img src="~/images/sluzby/AdvancedWeb.svg" />
		</div>
		<div>
			<h3>@SharedLocalizer["DescriptionLabel"]</h3>
			<p class="service--p">@SharedLocalizer["Web_AdvancedDesc"]</p>
		</div>
		<div class="serivce--price--div">
			<p class="service--price">@SharedLocalizer["Web_Price"]</p>
			<p class="service--p">@SharedLocalizer["Web_PriceNote"]</p>
		</div>
	</article>
	<article class="service__article reveal">
		<h2 class="service--h2">@SharedLocalizer["Web_CustomH2"]</h2>
		<div class="service--layout">
			<img src="~/images/sluzby/MegaWeb.svg" />
			<p>@SharedLocalizer["Web_CustomDesc"]</p>
		</div>
	</article>
	<h2 class="center__text reveal">@SharedLocalizer["Web_CTAH2"]</h2>
	<form class="contact__form reveal" method="post">
		<select class="input__form" name="ServiceRequestDto.SubService">
			<option value="BasicWeb">@SharedLocalizer["Web_SelectBasic"]</option>
			<option value="AdvancedWeb">@SharedLocalizer["Web_SelectAdvanced"]</option>
			<option value="CustomisedWeb">@SharedLocalizer["Web_SelectCustom"]</option>
		</select>
		<input class="input__form" type="email" name="ServiceRequestDto.Email" placeholder="@SharedLocalizer["EmailPlaceholder"]" required>
		<input class="input__form" type="text" name="ServiceRequestDto.PhoneNumber" placeholder="@SharedLocalizer["PhonePlaceholder"]">
		<textarea class="textarea__form" name="ServiceRequestDto.Message" cols="30" rows="10" placeholder="@SharedLocalizer["MessagePlaceholder"]" required></textarea>
		<button class="button form--button" type="submit">@SharedLocalizer["Submit"]</button>

		@if (TempData["SuccessMessage"] != null)
		{
			<div class="success-message">
				@TempData["SuccessMessage"]
			</div>
		}
		@if (ModelState.ErrorCount > 0)
		{
			<div class="error-message">
				@ModelState.Values.SelectMany(v => v.Errors).FirstOrDefault()?.ErrorMessage
			</div>
		}
	</form>
</main>
