@page
@model MojeVlastniStranka.Web.Pages.sluzby.socialnisiteModel

@{
	ViewData["Title"] = SharedLocalizer["Social_Title"];
	ViewData["Description"] = SharedLocalizer["Social_Desc"];
	ViewData["Author"] = "Jan Sebastián Kostlán";
	ViewData["Keywords"] = SharedLocalizer["Social_Keywords"];
	ViewData["Image"] = "https://kostlanovec.cz/images/socialnisite.jpg";
	ViewData["SocialTitle"] = SharedLocalizer["Social_SocialTitle"];
}

<main class="main">
	<header class="header header-service reveal">
		<div>
			<h1>@SharedLocalizer["Social_H1"]</h1>
			<p>@SharedLocalizer["Social_Intro"]</p>
		</div>
		<img src="~/images/sluzby/ServiceSocialNetwork.svg">
	</header>
	<article class="service__article reveal">
		<h2 class="service--h2">@SharedLocalizer["Social_BasicH2"]</h2>
		<div class="service--layout">
			<img src="~/images/sluzby/SocialNetworkBasic.svg" />
			<ul class="ul__service">
				<li>@SharedLocalizer["Social_BasicUL1"]</li>
				<li>@SharedLocalizer["Social_BasicUL2"]</li>
				<li>@SharedLocalizer["Social_BasicUL3"]</li>
				<li class="li--x">@SharedLocalizer["Social_BasicULX"]</li>
			</ul>
		</div>
		<div>
			<h3>@SharedLocalizer["DescriptionLabel"]</h3>
			<p class="service--p">@SharedLocalizer["Social_BasicDesc"]</p>
		</div>
		<div class="serivce--price--div">
			<p class="service--price">@SharedLocalizer["Social_BasicPrice"]</p>
		</div>
	</article>
	<article class="service__article reveal">
		<h2 class="service--h2">@SharedLocalizer["Social_AdvancedH2"]</h2>
		<div class="service--layout">
			<ul class="ul__service">
				<li>@SharedLocalizer["Social_AdvancedUL1"]</li>
				<li>@SharedLocalizer["Social_AdvancedUL2"]</li>
				<li>@SharedLocalizer["Social_AdvancedUL3"]</li>
				<li>@SharedLocalizer["Social_AdvancedUL4"]</li>
			</ul>
			<img src="~/images/sluzby/SocialNetworkAdvanced.svg" />
		</div>
		<div>
			<h3>@SharedLocalizer["DescriptionLabel"]</h3>
			<p class="service--p">@SharedLocalizer["Social_AdvancedDesc"]</p>
		</div>
		<div class="serivce--price--div">
			<p class="service--price">@SharedLocalizer["Social_AdvancedPrice"]</p>
		</div>
	</article>
	<article class="service__article reveal">
		<h2 class="service--h2">@SharedLocalizer["Social_LongH2"]</h2>
		<div class="service--layout">
			<img src="~/images/sluzby/MarketingNaMiru.svg" />
			<ul class="ul__service">
				<li>@SharedLocalizer["Social_LongUL1"]</li>
				<li>@SharedLocalizer["Social_LongUL2"]</li>
				<li>@SharedLocalizer["Social_LongUL3"]</li>
				<li>@SharedLocalizer["Social_LongUL4"]</li>
			</ul>
		</div>
		<div>
			<h3>@SharedLocalizer["DescriptionLabel"]</h3>
			<p class="service--p">@SharedLocalizer["Social_LongDesc"]</p>
		</div>
		<div class="serivce--price--div">
			<p class="service--price">@SharedLocalizer["Social_LongPrice"]</p>
		</div>
	</article>
	<h2 class="center__text reveal">@SharedLocalizer["Social_CTAH2"]</h2>
	<form class="contact__form reveal" method="post">
		<select class="input__form" name="ServiceRequestDto.SubService">
			<option value="BasicSocialNetworks">@SharedLocalizer["Social_SelectBasic"]</option>
			<option value="AdvancedSocialNetworks">@SharedLocalizer["Social_SelectAdvanced"]</option>
			<option value="CollaborationSocialNetworks">@SharedLocalizer["Social_SelectCollaboration"]</option>
		</select>
		<input class="input__form" type="email" name="ServiceRequestDto.Email" placeholder="@SharedLocalizer["EmailPlaceholder"]" required>
		<input class="input__form" type="text" name="ServiceRequestDto.PhoneNumber" placeholder="@SharedLocalizer["PhonePlaceholder"]">
		<textarea class="textarea__form" name="ServiceRequestDto.Message" cols="30" rows="10" placeholder="@SharedLocalizer["MessagePlaceholder"]" required></textarea>
		<button class="button form--button" type="submit">@SharedLocalizer["Submit"]</button>

		@if (TempData["SuccessMessage"] != null)
		{
			<div class="success-message">
				@TempData["SuccessMessage"]
			</div>
		}
		@if (ModelState.ErrorCount > 0)
		{
			<div class="error-message">
				@ModelState.Values.SelectMany(v => v.Errors).FirstOrDefault()?.ErrorMessage
			</div>
		}
	</form>
</main>
