@page
@using MojeVlastniStranka.ApplicationCore.Constants
@model MojeVlastniStranka.Web.Pages.sluzby.seoModel
@{
    ViewData[ViewDataKeys.Title] = SharedLocalizer["Seo_Title"];
    ViewData[ViewDataKeys.Description] = SharedLocalizer["Seo_Desc"];
    ViewData[ViewDataKeys.Author] = "Jan Sebastián Kostlán";
    ViewData[ViewDataKeys.Keywords] = SharedLocalizer["Seo_Keywords"];
    ViewData[ViewDataKeys.Image] = "https://kostlanovec.cz/images/tvorbaher.jpg";
    ViewData[ViewDataKeys.SocialTitle] = SharedLocalizer["Seo_SocialTitle"];
}
<main class="main">
    <header class="header header-service reveal">
        <div>
            <h1>@SharedLocalizer["Seo_H1"]</h1>
            <p>@SharedLocalizer["Seo_Intro"]</p>
        </div>
        <img src="~/images/sluzby/SeoService.svg" />
    </header>
    <article class="service__article reveal">
        <h2 class="service--h2">@SharedLocalizer["Seo_BasicH2"]</h2>
        <div class="service--layout">
            <img src="~/images/sluzby/SeoBasic.svg" />
            <ul class="ul__service">
                <li>@SharedLocalizer["Seo_BasicUL1"]</li>
                <li>@SharedLocalizer["Seo_BasicUL2"]</li>
                <li>@SharedLocalizer["Seo_BasicUL3"]</li>
                <li class="li--x">@SharedLocalizer["Seo_BasicULX"]</li>
            </ul>
        </div>
        <div>
            <h3>@SharedLocalizer["DescriptionLabel"]</h3>
            <p class="service--p">@SharedLocalizer["Seo_BasicDesc"]</p>
        </div>
        <div class="serivce--price--div">
            <p class="service--price">@SharedLocalizer["Seo_BasicPrice"]</p>
        </div>
    </article>
    <article class="service__article reveal">
        <h2 class="service--h2">@SharedLocalizer["Seo_AdvancedH2"]</h2>
        <div class="service--layout">
            <ul class="ul__service">
                <li>@SharedLocalizer["Seo_AdvancedUL1"]</li>
                <li>@SharedLocalizer["Seo_AdvancedUL2"]</li>
                <li>@SharedLocalizer["Seo_AdvancedUL3"]</li>
                <li>@SharedLocalizer["Seo_AdvancedUL4"]</li>
            </ul>
            <img src="~/images/sluzby/SeoAdvanced.svg" />
        </div>
        <div>
            <h3>@SharedLocalizer["DescriptionLabel"]</h3>
            <p class="service--p">@SharedLocalizer["Seo_AdvancedDesc"]</p>
        </div>
        <div class="serivce--price--div">
            <p class="service--price">@SharedLocalizer["Seo_AdvancedPrice"]</p>
        </div>
    </article>
    <h2 class="center__text reveal">@SharedLocalizer["Seo_CTAH2"]</h2>
    <form class="contact__form reveal" method="post">
        <select class="input__form" name="ServiceRequestDto.SubService">
            <option value="BasicSeo">@SharedLocalizer["Seo_SelectBasic"]</option>
            <option value="Advanced">@SharedLocalizer["Seo_SelectAdvanced"]</option>
        </select>
        <input class="input__form" type="email" name="ServiceRequestDto.Email" placeholder="@SharedLocalizer["EmailPlaceholder"]" required>
        <input class="input__form" type="text" name="ServiceRequestDto.PhoneNumber" placeholder="@SharedLocalizer["PhonePlaceholder"]">
        <textarea class="textarea__form" name="ServiceRequestDto.Message" cols="30" rows="10" placeholder="@SharedLocalizer["MessagePlaceholder"]" required></textarea>
        <button class="button form--button" type="submit">@SharedLocalizer["Submit"]</button>
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="success-message">
                @TempData["SuccessMessage"]
            </div>
        }
        @if (ModelState.ErrorCount > 0)
        {
            <div class="error-message">
                @ModelState.Values.SelectMany(v => v.Errors).FirstOrDefault()?.ErrorMessage
            </div>
        }
    </form>
</main>
