@page
@model MojeVlastniStranka.Web.Pages.sluzby.seoModel

@{
	ViewData["Title"] = "SEO";
	ViewData["Description"] = "Optimalizování stránek na míru jako je On page a off page. Jan Sebastián Kostlán - Tvůrce, webdesigner, programátor a marketing maestro skrz SEO.";
	ViewData["Author"] = "Jan Sebastián Kostlán";
	ViewData["Keywords"] = "SEO, optimalizace, analytics";
}
<header class="header__other fadeInRight visible">
	<h1 class="header__h1">SEO</h1>
	<p class="header__p">Optimalizace webových stránek na míru</p>
</header>
<main class="main">
	<article class="fadeInUp visible">
		<h2 class="h2__div__article red">Definování cílů</h2>
		<p>Definujeme si naši základnu zákazníku.</p>
		<h2 class="h2__div__article red">Off page</h2>
		<p>Off page optimalizace je optimalizace mimo stránku. Zahrnuje to například získávání zpětných odkazů.</p>
		<h2 class="h2__div__article red">On page</h2>
		<p>On page optimalizace je optimalizace na stránce. Zahrnuje to například optimalizaci obsahu.</p>
		<h2 class="h2__div__article">Zpětná analýza skrz google analytics</h2>
		<p>Google analytics je nástroj, který nám pomáhá analyzovat naše stránky.</p>
	</article>
</main>