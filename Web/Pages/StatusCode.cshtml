@page "{code:int}"
@model MojeVlastniStrankaFinal.Web.Pages.StatusCodeModel
@{
	ViewData["Title"] = @Model.Code;
	ViewData["nofollow"] = "true";
}
<link rel="stylesheet" href="/js/Game/style.css">

<main class="main">
	@if (Model.Code == 404)
	{
		<h1>404 Error</h1>
		<p>Omlouváme se, ale náš server neumí cítit emoce, ale určité víme, že vás mrzí, že jste nenašli to, co jste hledali :(.</p>
	}
	else
	{
		<h1>@Model.Code - Chyba</h1>
		<p>Omlouváme se, ale došlo k chybě při zpracování vašeho požadavku.</p>
	}
	<p>Ale nesmutni mi, ber to jako skvělý čas na procvičování psaní!</p>
	<div class="wrapper">
		<input type="text" class="input-field">
		<div class="content-box">
			<div class="typing-text">
				<p></p>
			</div>
			<div class="content">
				<ul class="result-details">
					<li class="time">
						<p>Time Left:</p>
						<span><b>60</b>s</span>
					</li>
					<li class="mistake">
						<p>Mistakes:</p>
						<span>0</span>
					</li>
					<li class="wpm">
						<p>WPM:</p>
						<span>0</span>
					</li>
					<li class="cpm">
						<p>CPM:</p>
						<span>0</span>
					</li>
				</ul>
				<button>Try Again</button>
			</div>
		</div>
	</div>
	<script src="/js/Game/paragraphs.js"></script>
	<script src="/js/Game/script.js"></script>
</main>