@page
@model MojeVlastniStranka.Web.Pages.projekty.IndexModel
@using MojeVlastniStranka.DataAccess.Enums
@*todo tenhle enums se mi opravdu nelíbí, opravit!!!*@
@{
    ViewData["Title"] = "Moje projekty";
}

<main class="main">
    <h1>Projekty</h1>
    <div class="projects__container">
        <button class="arrow--project" onclick="toggleSection('development-projects')"></button>
        <h2>Rozpracované projekty</h2>
    </div>
    <section id="development-projects" class="projects__section">
        @foreach (var project in Model.AllProjects.Where(p => p.projectStatus == ProjectStatus.Development))
        {
            <article class="project">
                <a href="/projekty/@project.Slug">
                <img src="@project.ImagePath" alt="@project.Name" />
                <h3>@project.Name</h3>
                <div>
                     <p>@project.Description</p>
                </div>
               </a>
            </article>
        }
    </section>
    <div class="projects__container">
        <button onclick="toggleSection('development-projects')"></button>
        <h2>Hotové projekty</h2>
    </div>
    <section id="finalized-projects" class="projects__section">
        @foreach (var project in Model.AllProjects.Where(p => p.projectStatus == ProjectStatus.Finalized))
        {
            <article class="project">
                <img src="@project.ImagePath" alt="@project.Name" />
                <h3>@project.Name</h3>
                <p>@project.Description</p>
                <a href="/projekty/@project.Slug">Detail</a>
            </article>
        }
    </section>
    <div class="projects__container">
        <button onclick="toggleSection('playnning-projects')"></button>
        <h2>Plánované projekty</h2>
    </div>
    <section id="playnning-projects" class="projects__section">
        @foreach (var project in Model.AllProjects.Where(p => p.projectStatus == ProjectStatus.Planning))
        {
            <article class="project">
                <img src="@project.ImagePath" alt="@project.Name" />
                <h3>@project.Name</h3>
                <p>@project.Description</p>
                <a href="/projekty/@project.Slug">Detail</a>
            </article>
        }
    </section>
</main>
