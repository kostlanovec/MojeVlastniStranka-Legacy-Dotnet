@page
@model MojeVlastniStranka.Web.Pages.projekty.IndexModel
@{
    ViewData["Title"] = "Moje projekty";
}

<header class="header__other fadeInLeft visible">
    <h1 class="header__h1">Moje projekty</h1>
    <p class="header__p">Tohle je moje "skladiště" mých projektů, které plánuji nebo jsem již zrealizoval. Zde popisuji podrobně postup při realizaci projektu.</p>
</header>

<main class="main">
    <div>
        <button onclick="loadProjectsByStatus('All')">Všechny</button>
        <button onclick="loadProjectsByStatus('Planning')">Plánované</button>
        <button onclick="loadProjectsByStatus('Development')">V realizaci</button>
        <button onclick="loadProjectsByStatus('Finalized')">Dokončené</button>
    </div>
    <div id="projectsContainer">
    </div>
</main>

@section Scripts {
    <script>
        async function loadProjectsByStatus(status) {
            console.log(status);
            const response = await fetch(`/projekty?handler=GetProjectsByStatus&status=${status}`);
            const url = `?handler=GetProjectsByStatus&status=${status}`;
            console.log(url);
            console.log(response);
            console.log(response.json ());
            const projects = await response.json();
            console.log(projects)
            const container = document.getElementById('projectsContainer');
            container.innerHTML = '';
            projects.forEach(project => {
                const article = document.createElement('article');
                article.classList.add('article__project', 'fadeInUp', 'visible');

                const img = document.createElement('img');
                img.src = project.filePath;
                img.alt = "Projekt stránka";
                img.classList.add('img__border__radius');

                const div = document.createElement('div');
                div.classList.add('div__absolute');

                const h2 = document.createElement('h2');
                h2.classList.add('h2__article__project');
                h2.textContent = project.name;

                const p = document.createElement('p');
                p.classList.add('p__article__project');
                p.textContent = project.description;

                const a = document.createElement('a');
                a.classList.add('a__button__project');
                a.href = `/projekty/${project.slug}`;
                a.innerHTML = 'Podívat se &#10230;';

                div.appendChild(h2);
                div.appendChild(p);
                div.appendChild(a);

                article.appendChild(img);
                article.appendChild(div);

                container.appendChild(article);
            });
        }
    </script>
}
