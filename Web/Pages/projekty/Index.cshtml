@page
@model MojeVlastniStranka.Web.Pages.projekty.IndexModel
@{
}
<header class="header__other fadeInLeft visible">
	<h1 class="header__h1">Moje projekty</h1>
	<p class="header__p">Tohle je moje "skladiště" mých projektů, které plánuji nebo jsem již zrealizoval. Zde popisuji podrobně postup při realizaci projektu.</p>
</header>

<main class="main">
	
	@for (var i = 0; i < Model.Posts.Count; i++)
	{
		<article class="article__project fadeInUp visible">
			<img src="@Model.Posts[i].FilePath" alt="Projekt stránka" class="img__border__radius">
			<div class="div__absolute">
				<h2 class="h2__article__project">@Model.Posts[i].Name</h2>
				<p class="p__article__project">@Model.Posts[i].Description</p>
				<a class="a__button__project" href="/projekty/@Model.Posts[i].Slug">Podívat se &#10230;</a>
			</div>
		</article>
	}
</main>