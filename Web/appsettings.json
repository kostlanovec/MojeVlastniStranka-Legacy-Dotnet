{
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	"AllowedHosts": "*",
	"GoogleRecaptcha": {
		"VefiyAPIAddress": "https://www.google.com/recaptcha/api/siteverify",
		"Sitekey": "YOUR-GOOGLE-SITEKEY-HERE",
		"Secretkey": "YOUR-GOOGLE-SECRETKEY-HERE"
	},
	"RecaptchaThreshold": "0,5"
}