@page
@model ErrorModel
@{
    ViewData["Title"] = "Chyba";
}
<h1 class="text-danger">Chyba.</h1>
<p class="text-danger">Došlo k chybě při zpracování požadavku. <a href="mailto:info@kostlanovec.cz">info@kostlanovec.cz</a></p>
<p>O chybě víme a pracujeme na její nápravě.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}