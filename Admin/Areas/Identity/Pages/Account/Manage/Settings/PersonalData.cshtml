z@page
@model MojeVlastniStranka.Admin.Areas.Identity.Pages.Account.Manage.Settings.PersonalDataModel
@{
    ViewData["Title"] = "Personal Data";
}

<h4>@ViewData["Title"]</h4>

<div class="container-fluid pt-4 px-4 mt-4">
	<form asp-page="DownloadPersonalData" method="post" class="form-group">
		<div class="bg-secondary rounded h-100 p-4">
		<p>Your account contains personal data that you have given us. This page allows you to download or delete that data.</p>
		<p>
			<strong>Deleting this data will permanently remove your account, and this cannot be recovered.</strong>
		</p>
		<button class="btn btn-primary" type="submit">Download</button>
		<p>
			<a asp-page="DeletePersonalData" class="btn btn-default">Delete</a>
		</p>
		</div>
	</form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}