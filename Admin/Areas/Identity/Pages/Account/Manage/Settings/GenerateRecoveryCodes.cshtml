@page
@model MojeVlastniStranka.Admin.Areas.Identity.Pages.Account.Manage.Settings.GenerateRecoveryCodesModel
@{
    ViewData["Title"] = "Generate two-factor authentication (2FA) recovery codes";
}
<div class="bg-secondary rounded h-100 p-4">
<partial name="_StatusMessage" for="StatusMessage" />
<h4>@ViewData["Title"]</h4>
< class="alert alert-warning" role="alert">
    <p>
        <span class="glyphicon glyphicon-warning-sign"></span>
        <strong>Ulož tyto obnovovací klíče na bezpečné místo.</strong>
    </p>
    <p>
        Když ztratíte zařízení a nebude mít obnovovací klíče, tak ztratíte přístup k účtu.
    </p>
    <p>
        Nové vygenerovné klíče neobsahují klíče používatené v autentizační aplikaci. Pokud si přejete změnit tyto klíče v autentizační aplikaci, tak použijte <a asp-page="./ResetAuthenticator">Změnit autentizační klíč</a>
    </p>

<div>
	<form method="post" class="form-group"> 
		<button class="btn btn-danger" type="submit">Vygenerovat obnovovací klíče</button>
	</form>
</div>
</div>
