@page
@model MojeVlastniStranka.Admin.Areas.Identity.Pages.Account.Manage.Settings.EnableAuthenticatorModel
@{
    ViewData["Title"] = "Configure authenticator app";
}

		<div class="bg-secondary rounded h-100 p-4">
			<partial name="_StatusMessage" for="StatusMessage" />
			<p>Pro použití aplikace pro ověřování dvoufaktorové autentizace postupujte následujícím způsobem:</p>
			<ol class="list">
				<li>
					<p>
						Stáhněte si aplikaci pro dvoufaktorovou autentizaci, například Microsoft Authenticator pro
						<a href="https://go.microsoft.com/fwlink/?Linkid=825072">Android</a> a
						<a href="https://go.microsoft.com/fwlink/?Linkid=825073">iOS</a> nebo
						Google Authenticator pro
						<a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2&amp;hl=en">Android</a> a
						<a href="https://itunes.apple.com/us/app/google-authenticator/id388497605?mt=8">iOS</a>.
					</p>
				</li>
				<li>
					<p>Skenujte QR kód nebo zadejte tuto klíčovou hodnotu <kbd>@Model.SharedKey</kbd> do vaší aplikace pro dvoufaktorovou autentizaci. Mezery a velikost písmen nezáleží.</p>
					<div class="bg-white p-4" id="qrCode"></div>
					<div id="qrCodeData" data-url="@Html.Raw(Model.AuthenticatorUri)"></div>
				</li>
				<li>
					<p>
						Po naskenování QR kódu nebo zadání klíče výše vám vaše aplikace pro dvoufaktorovou autentizaci poskytne
						jedinečný kód. Zadejte tento kód do potvrzovacího pole níže.
					</p>
					<div class="row">
						<div class="col-md-6">
							<form method="post">
								<div class="form-group">
									<label asp-for="Input.Code" class="control-label">Ověřovací kód</label>
									<input asp-for="Input.Code" class="form-control" autocomplete="off"/>
									<span asp-validation-for="Input.Code" class="text-danger"></span>
								</div>
								<button type="submit" class="btn btn-primary">Ověřit</button>
								<div asp-validation-summary="ModelOnly" class="text-danger"></div>
							</form>
						</div>
					</div>
				</li>
			</ol>
		</div>


@section Scripts {
	@await Html.PartialAsync("_ValidationScriptsPartial")

	<script type="text/javascript" src="~/lib/generatorqrcode/qrcode.js"></script>
	<script type="text/javascript" src="~/js/qr.js"></script>
}