@page
@model EmailModel
@{
    ViewData["Title"] = "Nastavení emailu";
}

<div class="bg-secondary rounded h-100 p-4">
	<partial name="_StatusMessage" model="Model.StatusMessage" />
	<form id="email-form" method="post">
		<div asp-validation-summary="All" class="text-danger"></div>
		<div class="form-group">
			<label asp-for="Email"></label>
			@if (Model.IsEmailConfirmed)
			{
				<div class="input-group">
					<input asp-for="Email" class="form-control" disabled/>
					<span class="input-group-addon" aria-hidden="true"><span class="glyphicon glyphicon-ok text-success"></span></span>
				</div>
			}
			else
			{
				<input asp-for="Email" class="form-control" disabled/>
				<button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link mt-2">Odeslání ověřovacího emailu</button>
			}
		</div>
		<div class="form-group mt-2">
			<label class="mt-2" asp-for="Input.NewEmail"></label>
			<input asp-for="Input.NewEmail" class="form-control"/>
			<span asp-validation-for="Input.NewEmail" class="text-danger"></span>
		</div>
		<button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn btn-primary mt-2">Změna emailu</button>
	</form>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}