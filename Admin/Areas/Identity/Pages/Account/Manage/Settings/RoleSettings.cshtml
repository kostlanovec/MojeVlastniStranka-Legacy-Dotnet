@page
@model MojeVlastniStranka.Admin.Areas.Identity.Pages.Account.Manage.Settings.RoleSettingsModel
@{
	ViewData["Title"] = "Role Management";
}
<div class="bg-secondary rounded h-100 p-4">
<h1>Role Management</h1>

<h3>Create New Role</h3>
<form method="post" asp-page-handler="Create">
	<div class="form-group">
		<label asp-for="NewRoleName"></label>
		<input asp-for="NewRoleName" class="form-control" />
		<span asp-validation-for="NewRoleName" class="text-danger"></span>
	</div>
	<button type="submit" class="btn btn-primary">Create</button>
</form>

<hr />

<h3>Existing Roles</h3>
<table class="table">
	<thead>
	<tr>
		<th>Role Name</th>
		<th>Actions</th>
		<th>Users in Role</th> <!-- Add this header -->
	</tr>
	</thead>
	<tbody>
	@foreach (var role in Model.Roles)
	{
		<tr>
			<td>@role.Name</td>
			<td>
				<form method="post" asp-page-handler="Edit" asp-route-id="@role.Id">
					<button type="submit" class="btn btn-primary">Edit</button>
				</form>
				<form method="post" asp-page-handler="Delete" asp-route-id="@role.Id">
					<button type="submit" class="btn btn-danger">Delete</button>
				</form>
			</td>
			<td>
			</td>
		</tr>
	}
	</tbody>
</table>


<h3>All users</h3>
<table class="table">
	<thead>
	<tr>
		<th>UserName</th>
		<th>Email</th>

	</tr>
	</thead>
	<tbody>
	@foreach (var user in Model.userRoles)
	{


		<tr>
			@user
		</tr>

	}	

	</tbody>

	
</table>
</div>