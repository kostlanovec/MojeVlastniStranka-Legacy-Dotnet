@inject SignInManager<AdminUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}

<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/css/bootstrap.min.css">
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://stackpath.bootstrapcdn.com/bootstrap/5.3.0/js/bootstrap.min.js"></script>

<style>
	.additional-nav-link  {
		padding-left: 2em;
	}

	.additional-windows{
		flex-direction: column;
	}

</style>

	<nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block bg-light sidebar collapse">
		<div class="position-sticky pt-3">
			<ul class="nav flex-column">
				<li class="nav-item">
					<div class="nav-link toggle active" data-toggle="user-settings"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-home" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>Základní nastavení</div>
						<div class="additional-windows" data-toggle-id="user-settings" style="display:none;">
							<a class="additional-nav-link" id="profile" asp-page=":/./Index">Profile</a>
							<a class="additional-nav-link" id="email" asp-page="././Email">Email</a>
							<a class="additional-nav-link" id="change-password" asp-page="././ChangePassword">Password</a>
							<a class="additional-nav-link" id="two-factor" asp-page="/./TwoFactorAuthentication">Two-factor authentication</a>
							<a class="additional-nav-link" id="personal-data" asp-page="./PersonalData">Personal data</a>
					</div>
				</li>
				<li class="nav-item">
					<div class="nav-link toggle active" data-toggle="blog-section"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-home" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>Blog</div>
						<div class="additional-windows" data-toggle-id="blog-section" style="display:none;">
							<a class="additional-nav-link" id="blogList" asp-page="././Blog/BlogList"> Seznam blogů</a>
							<a class="additional-nav-link" id="Writeblog" asp-page="././Blog/WriteBlog">Napsat blog</a>
							<a class="additional-nav-link" id="addImage" asp-page="././Blog/AddImage">Přidání obrázku do galerie</a>
						</div>
				</li>
				<li class="nav-item">
					<div class="nav-link toggle active" data-toggle="contact-section">						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-shopping-cart" aria-hidden="true"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg> Kontakt</div>
					<div class="additional-windows" data-toggle-id="contact-section" style="display:none;">
						<a class="additional-nav-link" id="blogList" asp-page="././Contact/TableContentForm">Kontakní formulář</a>
					</div>
				</li>
			</ul>
		</div>
	</nav>
<script>
	document.querySelectorAll('.toggle').forEach(function (toggle) {
		toggle.addEventListener('click', function () {
			var toggleId = toggle.getAttribute('data-toggle');
			document.querySelectorAll('.additional-windows[data-toggle-id="' + toggleId + '"]').forEach(function (window) {
				if (window.style.display === 'none') {
					window.style.display = 'flex';
				} else {
					window.style.display = 'none';
				}
			});
		});
	});
</script> 


