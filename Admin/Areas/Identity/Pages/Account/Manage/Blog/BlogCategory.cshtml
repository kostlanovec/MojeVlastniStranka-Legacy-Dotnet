@page
@model MojeVlastniStranka.Admin.Areas.Identity.Pages.Blog.BlogCategoryModel
@{
	ViewData["Title"] = "Blog kategorie";
}
<div class="bg-secondary rounded h-100 p-4">
	<form method="post" class="mb-4">
		<label for="CategoryNameAdd">Nová kategorie:</label>
		<input class="form-control" name="CategoryNameAdd" id="CategoryNameAdd"/>
		<button class="btn btn-success mt-2" type="submit" asp-page-handler="AddCategory">Přidat kategorii</button>
	</form>

	<form method="post">
		<select class="form-select mb-2" name="Id">
			<option value="">Všechny kategorie</option>
			@foreach (var category in Model.BlogCategory)
			{
				<option value="@category.Id">@category.Name</option>
			}
		</select>
		<div class="alert alert-primary alert-dismissible fade show" role="alert"> <i class="fa fa-exclamation-circle me-2"></i>Při smazání blog kategorie se příspěvky náležící k smazané blog kategorii přesunout do kategorie neurčený <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div>
		<button type="submit" class="btn btn-primary mt-2" asp-page-handler="DeleteCategory">Smazat blog kategorii</button>
	</form>
</div>