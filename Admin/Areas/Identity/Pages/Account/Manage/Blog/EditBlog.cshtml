@page
@model MojeVlastniStranka.Admin.Areas.Identity.Pages.Account.Manage.EditBlogPostModel
@{
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.16.0/umd/popper.min.js"></script>

<link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.js"></script>
<script src="/js/summernote/Plugins/summernote-ext-addclass.js"></script>
<script src="/js/summernote/Plugins/summernote-ownplugin.js"></script>
<script src="/lib/typo-js/typo.js"></script>


<link rel="stylesheet" href="~/css/fast-style.css" asp-append-version="true" />
<div class="col-md-12">
	@if (!string.IsNullOrEmpty(Model.SuccessMessage))
	{
		<div class="alert alert-success">
			@Model.SuccessMessage
		</div>
	}

	else if (!ViewData.ModelState.IsValid)
	{
		<div class="alert alert-danger">
			@Html.ValidationSummary(false, "", new { @class = "text-danger" })
		</div>
	}

	<div id="summernote"></div>
	<button id="editSettingsBtn" class="btn btn-primary">Publikovat</button>
</div>


<style>
	#settingsTable {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-color: rgba(0, 0, 0, 0.8);
		z-index: 999;
		display: none;
	}

	#settingsForm {
		padding: 20px;
	}
</style>
<div class="container d-flex justify-content-center">
<div id="settingsTable">
	<div class="container">
		<div class="row">
				<div class="col-md-4  mx-auto" style="margin-top:80px">
				<form id="settingsForm" method="post" enctype="multipart/form-data">
					<div class="form-group">
						<label for="Name" class="text-white">Jméno blogu:</label>
						<input name="Name" type="text" class="form-control" value="@Model.EditBlogPostDto.Name" required />
					</div>
					<div class="form-group">
						<label for="Slug" class="text-white">Url blogu:</label>
						<input name="Slug" type="text" class="form-control" value="@Model.EditBlogPostDto.Slug" required/>
					</div>
					<div class="form-group">
						<label for="Title" class="text-white">Titulek:</label>
						<input type="text" class="form-control" name="Title" value="@Model.EditBlogPostDto.Title" required/>
					</div>
					<div class="form-group">
						<label for="Description" class="text-white">Popis:</label>
						<input type="text" class="form-control" name="Description" value="@Model.EditBlogPostDto.Description" required/>
					</div>
					<div class="form-group">
						<label for="Author" class="text-white">Autor:</label>
						<input type="text" class="form-control" name="Author" value="@Model.EditBlogPostDto.Author" required/>
					</div>
					<div class="form-group">
						<label for="Keywords" class="text-white">Klíčová slova:</label>
						<input type="text" class="form-control" name="Keywords" value="@Model.EditBlogPostDto.Keywords" required/>
					</div>
					<div class="form-group">
						<label for="file" class="text-white">Obrázek:</label>
						<input type="file" class="form-control-file" name="File" id="file"/>
						<div id="image-preview">
							<img src="https://localhost:7207/@Model.EditBlogPostDto.FileUpload"/>
						</div>
					</div>
					<div class="form-group">
						<label for="BlogCategoryId" class="text-white">Kategorie blogů:</label>
						<select class="form-control" name="BlogCategoryId">
							@foreach (var category in Model.BlogCategory)
							{
								<option value=@category.Id>@category.Name</option>
							}
						</select>
					</div>
					<input type="hidden" name="Content" id="hiddenContent"/>
					<button type="submit" asp-page-handler="DeleteBlogById" class="btn btn-danger">Odstranit</button>
					<button id="backBtn" class="btn btn-primary">Zpátky</button>
					<button type="submit" asp-page-handler="UpdateBlogPost" class="btn btn-secondary">Aktualizovat</button>
				</form>
			</div>
		</div>
	</div>
</div>
</div>

<script>
	// Show/hide settings table on button click
	$('#editSettingsBtn').click(function () {
		$('#settingsTable').toggle();
	});

	// Tlačítko pro vrácení zpět
	$('#backBtn').click(function () {
		
		$('#settingsTable').hide();
	});

	$('#summernote').summernote({
		// popover: {
		// 	image: [
		// 		['custom', ['imageAttributes']],
		// 		['imagesize', ['imageSize100', 'imageSize50', 'imageSize25']],
		// 		['float', ['floatLeft', 'floatRight', 'floatNone']],
		// 		['remove', ['removeMedia']]
		// 	],
		// },
		// imageAttributes: {
		// 	icon: '<i class="note-icon-pencil"/>',
		// 	removeEmpty: false, // true = remove attributes | false = leave empty if present
		// 	disableUpload: false // true = don't display Upload Options | Display Upload Options
		// },
		lang: 'cs-CZ',
		spellCheck: true,
		addclass: {
			debug: false,
			classTags: [{ title: "Button", "value": "btn btn-success" }, "body", "red", "h2__div__article", "header__h1", "fadeInLeft", "header__other", "header__p", "main"]
		},
		focus: true,
		height: 300,
		toolbar: [
			['structure', ['structurePlugin']],
			['img', ['picture']],
			['style', ['style', 'addclass', 'clear']],
			['fontstyle', ['bold', 'italic', 'ul', 'ol', 'link', 'paragraph']],
			['fontstyleextra', ['strikethrough', 'underline', 'hr', 'color', 'superscript', 'subscript']],
			['extra', ['video', 'table', 'height']],
			['misc', ['undo', 'redo', 'codeview', 'help']],
			['fontname', ['fontname']],
			['fullscreen', ['fullscreen']]
		],
		callbacks: {
			onInit: function () {
				var htmlContent = '@Html.Raw(Model.EditBlogPostDto.Content)';
				$('#summernote').summernote('code', htmlContent);
			}
			// onChange: function (contents, $editable) {
			// 	console.log("tady jsem");
			// 	var words = contents.replace(/<(?:.|\n)*?>/gm, '').split(/\s/);
			// 	var misspelled = [];
			// 	var dictionary = new Typo("en_US", false, false, { dictionaryPath: "localhost:7089/dictionaries" });

			// 	words.forEach(function (word) {
			// 		if (!dictionary.check(word) && !misspelled.includes(word)) {
			// 			misspelled.push(word);
			// 		}
			// 	});


			// 	console.log("Chyby v pravopisu:", misspelled);
			// }
		}
	});

	$('form').on('submit', function () {
		var htmlContent = $('.note-editable').html().trim();
		$('#hiddenContent').val(htmlContent);
		if (htmlContent === '' || htmlContent === '<p><br></p>') {
			return null;
		}
	});

	function showImagePreview(input) {
		if (input.files && input.files[0]) {
			var reader = new FileReader();

			reader.onload = function (e) {
				var img = document.createElement('img');
				img.src = e.target.result;

				var previewDiv = document.getElementById('image-preview');
				previewDiv.innerHTML = '';
				previewDiv.appendChild(img);
			};

			reader.readAsDataURL(input.files[0]);
		}
	}


	document.getElementById('file').addEventListener('change', function () {
		showImagePreview(this);
	});

	$(document).ready(function () {
		$(window).scroll(function () {
			$('.fadeIn, .fadeInUp, .fadeInDown, .fadeInRight, .fadeInLeft').each(function () {
				let position = $(this).offset().top;
				let topPosition = $(window).scrollTop() + $(window).height();
				if (position < topPosition) {
					$(this).addClass('visible');
				}
			});
		});
	});
</script>