@page
@model LogoutModel
@{
    ViewData["Title"] = "Log out";
}

<header>
	<h1>Chcete se opravdu odhlásit?</h1>
    @{
        if (User.Identity?.IsAuthenticated ?? false)
        {
            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/Index.html", new { area = "" })" method="post">
                <button type="submit" class=" btn btn-primary">Klikni pro odhlášení</button>
            </form>
        }
        else
        {
            <p>Byl jsi úspěšné odhlášený.</p>
        }
    }
</header>
